@using MorningInk.Domain
@using MorningInk.Infrastructure.Sources
@inject ActionScopes Scopes

@* Name, limits and filters of one source; the filters run before the full text is fetched (see ArticleFilter). *@
<form id="edit-@Source.Id" class="source-editor" @onsubmit="SaveAsync">
    <div class="inline-form field">
        <div class="row-main">
            <label class="label" for="source-name">@T["Sources_Name"]</label>
            <input id="source-name" class="input" @bind="_edit.Name" required />
        </div>
        <div>
            <label class="label" for="source-max">@T["Sources_MaxArticles"]</label>
            <input id="source-max" class="input" type="number" min="1" max="100" @bind="_edit.MaxArticles" />
        </div>
    </div>
    <div class="field">
        <label for="source-include">@T["Sources_Include"]</label>
        <input id="source-include" class="input" @bind="_edit.Include" placeholder="@T["Sources_IncludePlaceholder"]" aria-describedby="source-include-hint" />
        <span id="source-include-hint" class="hint">@T["Sources_IncludeHint"]</span>
    </div>
    <div class="field">
        <label for="source-exclude">@T["Sources_Exclude"]</label>
        <input id="source-exclude" class="input" @bind="_edit.Exclude" placeholder="@T["Sources_ExcludePlaceholder"]" aria-describedby="source-exclude-hint" />
        <span id="source-exclude-hint" class="hint">@T["Sources_ExcludeHint"]</span>
    </div>
    <div class="inline-form field">
        <div>
            <label class="label" for="source-minwords">@T["Sources_MinWords"]</label>
            <input id="source-minwords" class="input" type="number" min="1" @bind="_edit.MinWords" placeholder="@T["Sources_NoMinimum"]" />
            <label class="label" for="source-maxwords">@T["Sources_MaxWords"]</label>
            <input id="source-maxwords" class="input" type="number" min="1" @bind="_edit.MaxWords" placeholder="@T["Sources_NoMaximum"]" aria-describedby="source-maxwords-hint" />
            <span id="source-maxwords-hint" class="hint">@T["Sources_MaxWordsHint"]</span>
        </div>
        <div class="row-main checks">
            <label class="checkbox"><input id="source-live" type="checkbox" @bind="_edit.SkipLiveTickers" /> @T["Sources_SkipLive"]</label>
            <label class="checkbox"><input id="source-ads" type="checkbox" @bind="_edit.SkipAds" aria-describedby="source-ads-hint" /> @T["Sources_SkipAds"]</label>
            <span id="source-ads-hint" class="hint">@T["Sources_SkipAdsHint"]</span>
            <label class="checkbox"><input id="source-media" type="checkbox" @bind="_edit.SkipMedia" aria-describedby="source-media-hint" /> @T["Sources_SkipMedia"]</label>
            <span id="source-media-hint" class="hint">@T["Sources_SkipMediaHint"]</span>
            <label class="checkbox"><input type="checkbox" @bind="_edit.FetchFullText" /> @T["Sources_FullText"]</label>
        </div>
    </div>
    <div class="field">
        <label class="checkbox"><input id="source-local-ai" type="checkbox" @bind="_edit.LocalAiOnly" aria-describedby="source-local-ai-hint" /> @T["Sources_LocalAiOnly"]</label>
        <span id="source-local-ai-hint" class="hint">@T["Sources_LocalAiOnlyHint"]</span>
    </div>
    <div class="field">
        <label class="checkbox"><input id="source-images" type="checkbox" @bind="_edit.LoadImages" aria-describedby="source-images-hint" /> @T["Sources_LoadImages"]</label>
        <span id="source-images-hint" class="hint">@T["Sources_LoadImagesHint"]</span>
    </div>
    @if (Source.Kind is SourceKind.FreshRss or SourceKind.Karakeep)
    {
        <div class="field">
            <label class="checkbox"><input id="source-mark-read" type="checkbox" @bind="_edit.MarkReadAfterDelivery" /> @T[Source.Kind == SourceKind.Karakeep ? "Sources_KarakeepArchive" : "Sources_MarkRead"]</label>
        </div>
    }
    @if (Source.Kind is SourceKind.HackerNews or SourceKind.Reddit)
    {
        <div class="field">
            <label for="source-minscore">@T["Sources_MinScore"]</label>
            <input id="source-minscore" class="input input-short" type="number" min="0" @bind="_edit.MinScore" aria-describedby="source-minscore-hint" />
            <span id="source-minscore-hint" class="hint">@T["Sources_MinScoreHint"]</span>
        </div>
    }
    @if (Source.Kind == SourceKind.Newsletter)
    {
        <div class="field">
            <label for="source-sender">@T["Sources_NewsletterSender"]</label>
            <input id="source-sender" class="input" @bind="_edit.Sender" placeholder="substack.com" aria-describedby="source-sender-hint" />
            <span id="source-sender-hint" class="hint">@T["Sources_NewsletterSenderHint"]</span>
        </div>
    }
    <div class="row-actions">
        <button type="submit" class="button button-small" disabled="@_busy">@T["Profile_Save"]<span class="visually-hidden"> – @Source.Name</span></button>
        <button type="button" class="link-button" @onclick="Cancelled">@T["Confirm_Cancel"]</button>
    </div>
</form>

@code {
    private SourceDraft _edit = new();
    private bool _busy;

    [Parameter, EditorRequired]
    public Source Source { get; set; } = default!; // ! is safe: EditorRequired, the page always passes the source

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public CancellationToken Cancellation { get; set; }

    [Parameter]
    public EventCallback<FormOutcome> Finished { get; set; }

    [Parameter]
    public EventCallback Cancelled { get; set; }

    protected override void OnInitialized() => _edit = new SourceDraft
    {
        Name = Source.Name,
        MaxArticles = Source.MaxArticles,
        Include = string.Join(", ", Source.IncludeKeywords),
        Exclude = string.Join(", ", Source.ExcludeKeywords),
        MinWords = Source.MinWords,
        MaxWords = Source.MaxWords,
        SkipLiveTickers = Source.SkipLiveTickers,
        FetchFullText = Source.FetchFullText,
        LocalAiOnly = Source.LocalAiOnly,
        MarkReadAfterDelivery = Source.MarkReadAfterDelivery,
        SkipAds = Source.SkipAds,
        SkipMedia = Source.SkipMedia,
        LoadImages = Source.LoadImages,
        Sender = Source.Sender,
        MinScore = Source.MinScore,
    };

    private async Task SaveAsync()
    {
        _busy = true;
        var settings = new SourceSettings(
            _edit.Name,
            _edit.FetchFullText,
            _edit.MaxArticles,
            SourceSettings.ParseKeywords(_edit.Include),
            SourceSettings.ParseKeywords(_edit.Exclude),
            _edit.MinWords,
            _edit.SkipLiveTickers,
            _edit.LocalAiOnly,
            _edit.SkipAds,
            _edit.MarkReadAfterDelivery,
            _edit.LoadImages,
            _edit.Sender,
            _edit.SkipMedia,
            _edit.MinScore,
            _edit.MaxWords);
        var result = await Scopes.RunAsync<SourceCatalog, SourceSaveResult>(catalog => catalog.SaveSettingsAsync(UserId, Source.Id, settings, Cancellation));
        _busy = false;
        await Finished.InvokeAsync(result is SourceSaveResult.Invalid invalid ? FormOutcome.Failed(T[$"Error_{invalid.Reason}"]) : new FormOutcome(T["Profile_Saved"]));
    }

    // The form's fields, as typed.
    private sealed class SourceDraft
    {
        public string Name { get; set; } = string.Empty;

        public int MaxArticles { get; set; }

        public string Include { get; set; } = string.Empty;

        public string Exclude { get; set; } = string.Empty;

        public int? MinWords { get; set; }

        public int? MaxWords { get; set; }

        public bool SkipLiveTickers { get; set; }

        public bool FetchFullText { get; set; }

        public bool LocalAiOnly { get; set; }

        public bool MarkReadAfterDelivery { get; set; } = true;

        public bool SkipAds { get; set; } = true;

        public bool SkipMedia { get; set; } = true;

        public bool LoadImages { get; set; } = true;

        public string? Sender { get; set; }

        public int? MinScore { get; set; }
    }
}
