@using MorningInk.Infrastructure
@* A select of all countries, names in the UI language; the empty choice searches worldwide. Use with @bind-Selected. *@

<select id="@Id" class="input" aria-describedby="@DescribedBy" @onchange="ChangedAsync">
    <option value="" selected="@(Selected is null)">@T["Country_Worldwide"]</option>
    @foreach (var (iso, name) in Countries.ForDisplay())
    {
        <option value="@iso" selected="@(iso == Selected)">@name</option>
    }
</select>

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public string? Selected { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedChanged { get; set; }

    [Parameter]
    public string? DescribedBy { get; set; }

    private Task ChangedAsync(ChangeEventArgs args)
    {
        var value = args.Value as string;
        return SelectedChanged.InvokeAsync(string.IsNullOrEmpty(value) ? null : value);
    }
}
