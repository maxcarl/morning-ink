@page "/settings"
@rendermode InteractiveServer
@inherits InteractivePage
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@using System.Globalization
@using MorningInk.Application.Delivery
@using MorningInk.Domain
@using MorningInk.Infrastructure.Delivery
@using MorningInk.Infrastructure.Http
@using MorningInk.Infrastructure.Profiles
@inject MailSettingsLocks Locks
@inject HostAllowlist Allowlist

<PageTitle>@T["Settings_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <span class="kicker">@T["Settings_Kicker"]</span>
    <h1>@T["Settings_Title"]</h1>
    <p class="lede">@T["Settings_Lede"]</p>
    @if (_notice is not null)
    {
        <div class="alert alert-ok" role="status"><p>@_notice</p></div>
    }
    @if (_errors.Count > 0)
    {
        <div class="alert alert-error" role="alert">
            @foreach (var error in _errors)
            {
                <p>@error</p>
            }
        </div>
    }
</header>

<div class="with-sidebar">
    <section aria-labelledby="mail-heading">
        <h2 id="mail-heading" class="department">@T["Settings_Mail"]</h2>
        <p class="hint">@T["Settings_MailHint"]</p>
        <form @onsubmit="SaveMailAsync">
            <div class="inline-form field">
                <div class="row-main">
                    <label class="label" for="host">@T["Settings_Host"]</label>
                    <input id="host" class="input" @bind="_host" readonly="@IsLocked(MailSettingsStore.HostField)" aria-describedby="host-lock" />
                    <LockHint Field="@MailSettingsStore.HostField" Id="host-lock" Locked="@Locks.Fields" />
                </div>
                <div>
                    <label class="label" for="port">@T["Settings_Port"]</label>
                    <input id="port" class="input" @bind="_port" inputmode="numeric" readonly="@IsLocked(MailSettingsStore.PortField)" />
                </div>
            </div>
            <div class="field">
                <label class="label" for="security">@T["Settings_Security"]</label>
                <select id="security" class="input" @bind="_security" disabled="@IsLocked(MailSettingsStore.SecurityField)">
                    @foreach (var option in Enum.GetValues<MailSecurity>())
                    {
                        <option value="@option">@T[$"Security_{option}"]</option>
                    }
                </select>
            </div>
            <div class="inline-form field">
                <div class="row-main">
                    <label class="label" for="username">@T["Settings_Username"]</label>
                    <input id="username" class="input" @bind="_username" autocomplete="off" readonly="@IsLocked(MailSettingsStore.UsernameField)" />
                </div>
                <div class="row-main">
                    <label class="label" for="password">@T["Settings_Password"]</label>
                    @* Never filled in from storage: a saved password does not leave the server again. *@
                    <input id="password" class="input" type="password" @bind="_password" autocomplete="new-password" readonly="@IsLocked(MailSettingsStore.PasswordField)" aria-describedby="password-hint" />
                    <span id="password-hint" class="hint">@(_passwordSaved ? T["Settings_PasswordSaved"] : T["Settings_PasswordNone"])</span>
                </div>
            </div>
            <div class="inline-form field">
                <div class="row-main">
                    <label class="label" for="from">@T["Settings_FromAddress"]</label>
                    <input id="from" class="input" @bind="_fromAddress" type="email" readonly="@IsLocked(MailSettingsStore.FromAddressField)" aria-describedby="from-lock" />
                    <LockHint Field="@MailSettingsStore.FromAddressField" Id="from-lock" Locked="@Locks.Fields" />
                </div>
                <div class="row-main">
                    <label class="label" for="from-name">@T["Settings_FromName"]</label>
                    <input id="from-name" class="input" @bind="_fromName" readonly="@IsLocked(MailSettingsStore.FromNameField)" />
                </div>
            </div>
            <button type="submit" class="button" disabled="@_busy">@T["Settings_Save"]</button>
        </form>

        <h2 class="department">@T["Settings_Network"]</h2>
        <p class="hint">@T["Settings_NetworkHint"]</p>
        <ul class="rows">
            @foreach (var entry in Allowlist.Configured)
            {
                <li class="row"><div class="row-main"><div class="row-title">@entry</div><div class="row-meta">@T["Settings_NetworkConfigured"]</div></div></li>
            }
            @foreach (var entry in Allowlist.Stored.Order(StringComparer.Ordinal))
            {
                <li class="row" @key="entry">
                    <div class="row-main"><div class="row-title">@entry</div></div>
                    <button type="button" class="link-button link-danger" @onclick="() => RemoveHostAsync(entry)">@T["Settings_NetworkRemove"]<span class="visually-hidden"> – @entry</span></button>
                </li>
            }
            @if (Allowlist.Configured.Count == 0 && Allowlist.Stored.Count == 0)
            {
                <li class="row muted">@T["Settings_NetworkNone"]</li>
            }
        </ul>
        <form @onsubmit="AddHostAsync" class="field">
            <label class="label" for="new-host">@T["Settings_NetworkAdd"]</label>
            <div class="inline-form">
                <input id="new-host" class="input" @bind="_newEntry" placeholder="freshrss.lan" aria-describedby="new-host-hint" required />
                <button type="submit" class="button button-secondary">@T["Settings_NetworkAdd"]</button>
            </div>
            <span id="new-host-hint" class="hint">@T["Settings_NetworkAddHint"]</span>
        </form>
    </section>

    <aside class="sidebar" aria-labelledby="test-heading">
        <h2 id="test-heading" class="label muted">@T["Settings_TestMail"]</h2>
        <p class="hint">@T["Settings_TestMailHint"]</p>
        <form @onsubmit="SendTestAsync">
            <div class="field">
                <label for="test-recipient">@T["Settings_TestRecipient"]</label>
                <input id="test-recipient" class="input" @bind="_testRecipient" type="email" required />
            </div>
            <button type="submit" class="button button-block" disabled="@_busy">@(_busy ? T["Settings_Sending"] : T["Settings_SendTest"])</button>
        </form>
    </aside>
</div>

@code {
    private List<string> _errors = [];
    private string? _notice;
    private bool _busy;

    private string? _host;
    private string? _port;
    private MailSecurity _security;
    private string? _username;
    private string? _password;
    private bool _passwordSaved;
    private string? _fromAddress;
    private string? _fromName;
    private string? _testRecipient;
    private string? _newEntry;

    protected override async Task LoadAsync()
    {
        await LoadMailAsync();
        _testRecipient = (await UseAsync<ProfileEditor, Profile>(editor => editor.GetOrCreateAsync(UserId, Closed))).Recipient;
    }

    private async Task LoadMailAsync()
    {
        var mail = await UseAsync<MailSettingsStore, MailSettings>(store => store.LoadAsync(Closed));
        _host = mail.Host;
        _port = mail.Port.ToString(CultureInfo.InvariantCulture);
        _security = mail.Security;
        _username = mail.Username;
        _password = null;
        _passwordSaved = mail.Password is not null;
        _fromAddress = mail.FromAddress;
        _fromName = mail.FromName;
    }

    private bool IsLocked(string field) => Locks.Fields.Contains(field);

    private async Task SaveMailAsync()
    {
        Clear();
        var input = new MailSettingsInput(_host, _port, _security, _username, _password, _fromAddress, _fromName);
        var errors = await UseAsync<MailSettingsStore, IReadOnlyList<string>>(store => store.SaveAsync(input, Closed));
        _errors = errors.Select(field => T[$"Settings_Error_{field}"].Value).ToList();
        if (_errors.Count == 0)
        {
            _notice = T["Settings_Saved"];
            await LoadMailAsync();
        }
    }

    private async Task SendTestAsync()
    {
        Clear();
        var recipient = _testRecipient?.Trim() ?? string.Empty;
        _busy = true;
        try
        {
            var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            switch (await UseAsync<TestMail, DeliveryResult>(mail => mail.SendAsync(recipient, language, Closed)))
            {
                case DeliveryResult.Failure failure:
                    _errors = [T["Settings_TestFailed", failure.Message]];
                    break;
                default:
                    _notice = T["Settings_TestSent", recipient];
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddHostAsync()
    {
        Clear();
        if (!string.IsNullOrWhiteSpace(_newEntry))
        {
            await Allowlist.AddAsync(_newEntry, UserId, Closed);
            _notice = T["Sources_Allowed", _newEntry.Trim().ToLowerInvariant()];
            _newEntry = null;
        }
    }

    private async Task RemoveHostAsync(string entry)
    {
        Clear();
        await Allowlist.RemoveAsync(entry, Closed);
        _notice = T["Settings_Saved"];
    }

    private void Clear()
    {
        _notice = null;
        _errors = [];
    }
}
