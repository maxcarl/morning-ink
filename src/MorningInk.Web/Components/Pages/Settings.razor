@page "/settings"
@rendermode InteractiveServer
@inherits InteractivePage
@attribute [Authorize(Roles = nameof(UserRole.Admin))]
@using System.Globalization
@using MorningInk.Application.Delivery
@using MorningInk.Domain
@using MorningInk.Infrastructure.Delivery
@using MorningInk.Infrastructure.Http
@using MorningInk.Infrastructure.Profiles
@using MorningInk.Infrastructure.Sources
@inject HostAllowlist Allowlist
@inject MorningInk.Infrastructure.Ai.AiChat AiChat

<PageTitle>@T["Settings_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <h1>@T["Settings_Title"]</h1>
    <p class="lede">@T["Settings_Lede"]</p>
    @if (_notice is not null)
    {
        <div class="alert alert-ok toast" role="status"><p>@_notice</p></div>
    }
    @if (_errors.Count > 0)
    {
        <div class="alert alert-error toast" role="alert">
            @foreach (var error in _errors)
            {
                <p>@error</p>
            }
        </div>
    }
</header>

<div class="form-column">
    <section aria-labelledby="mail-heading">
        <h2 id="mail-heading" class="department">@T["Settings_Mail"]</h2>
        <p class="hint">@T["Settings_MailHint"]</p>
        <MailServerForm Saved="MailSaved" Cancellation="Closed" />

        @* Right under the server it tests: one look shows whether mail reaches the Kindle. *@
        <h3 id="test-heading" class="subhead">@T["Settings_TestMail"]</h3>
        <p class="hint">@T["Settings_TestMailHint"]</p>
        <form @onsubmit="SendTestAsync" aria-labelledby="test-heading">
            <label class="label" for="test-recipient">@T["Settings_TestRecipient"]</label>
            <div class="inline-form">
                <input id="test-recipient" class="input" @bind="_testRecipient" type="text" inputmode="email" spellcheck="false" autocapitalize="none" autocomplete="off" @attributes="PasswordManagers.Ignore" required />
                <button type="submit" class="button button-secondary" disabled="@_busy">@(_busy ? T["Settings_Sending"] : T["Settings_SendTest"])</button>
            </div>
        </form>
    </section>

    <section aria-labelledby="ai-heading">
        <h2 id="ai-heading" class="department">@T["Settings_Ai"]</h2>
        <p class="hint">@T["Settings_AiHint"]</p>
        <form @onsubmit="SaveAiAsync">
            <div class="field">
                <label class="checkbox"><input id="ai-enabled" type="checkbox" @bind="_aiEnabled" aria-describedby="ai-enabled-hint" /> @T["Settings_AiEnabled"]</label>
                <span id="ai-enabled-hint" class="hint">@T["Settings_AiEnabledHint"]</span>
            </div>
            <div class="inline-form field">
                <div class="row-main">
                    <label class="label" for="ai-endpoint">@T["Settings_AiEndpoint"]</label>
                    <input id="ai-endpoint" class="input" @bind="_aiEndpoint" placeholder="http://192.168.1.20:11434" aria-describedby="ai-endpoint-hint" />
                    <span id="ai-endpoint-hint" class="hint">@T["Settings_AiEndpointHint"]</span>
                </div>
                <div>
                    <label class="label" for="ai-model">@T["Settings_AiModel"]</label>
                    <input id="ai-model" class="input" @bind="_aiModel" placeholder="qwen2.5:7b" />
                </div>
            </div>
            <div class="field">
                <label for="ai-key">@T["Settings_AiKey"]</label>
                @* Never filled in from storage, like the mail password. *@
                <input id="ai-key" class="input" type="password" @bind="_aiKey" autocomplete="new-password" @attributes="PasswordManagers.Ignore" aria-describedby="ai-key-hint" />
                <span id="ai-key-hint" class="hint">@(_aiKeySaved ? T["Settings_AiKeySaved"] : T["Settings_AiKeyNone"])</span>
            </div>
            <div class="field">
                <label class="checkbox"><input id="ai-local" type="checkbox" @bind="_aiLocal" /> @T["Settings_AiLocal"]</label>
                <label class="checkbox"><input id="ai-summaries" type="checkbox" @bind="_aiSummaries" /> @T["Settings_AiSummaries"]</label>
            </div>
            <div class="row-actions">
                <button type="submit" class="button" disabled="@_busy">@T["Settings_Save"]</button>
                <button type="button" class="button button-secondary" disabled="@_busy" @onclick="TestAiAsync">@(_busy ? T["Settings_AiTesting"] : T["Settings_AiTest"])</button>
            </div>
        </form>

    </section>

    <section aria-labelledby="news-heading">
        <h2 id="news-heading" class="department">@T["Settings_News"]</h2>
        <p class="hint">@T["Settings_NewsHint"]</p>
        <form @onsubmit="SaveNewsAsync">
            <div class="field">
                <label for="searxng-url">@T["Settings_SearxngUrl"]</label>
                <input id="searxng-url" class="input" @bind="_searxngUrl" placeholder="https://searx.example.com" readonly="@_searxngLocked" aria-describedby="searxng-hint" />
                <span id="searxng-hint" class="hint">@(_searxngLocked ? T["Settings_SearxngLocked"] : T["Settings_SearxngHint"])</span>
            </div>
            <div class="row-actions">
                @if (!_searxngLocked)
                {
                    <button type="submit" class="button" disabled="@_busy">@T["Settings_Save"]</button>
                }
                <button type="button" class="button button-secondary" disabled="@_busy" @onclick="TestNewsAsync">@T["Settings_SearxngTest"]</button>
            </div>
        </form>
    </section>

    <section aria-labelledby="network-heading">
        <h2 id="network-heading" class="department">@T["Settings_Network"]</h2>
        <p class="hint">@T["Settings_NetworkHint"]</p>
        <ul class="rows">
            @foreach (var entry in Allowlist.Configured)
            {
                <li class="row"><div class="row-main"><div class="row-title">@entry</div><div class="row-meta">@T["Settings_NetworkConfigured"]</div></div></li>
            }
            @foreach (var entry in Allowlist.Stored.Order(StringComparer.Ordinal))
            {
                <li class="row" @key="entry">
                    <div class="row-main"><div class="row-title">@entry</div></div>
                    <button type="button" class="link-button link-danger" @onclick="() => RemoveHostAsync(entry)">@T["Settings_NetworkRemove"]<span class="visually-hidden"> – @entry</span></button>
                </li>
            }
            @if (Allowlist.Configured.Count == 0 && Allowlist.Stored.Count == 0)
            {
                <li class="row muted">@T["Settings_NetworkNone"]</li>
            }
        </ul>
        <form @onsubmit="AddHostAsync" class="field">
            <label class="label" for="new-host">@T["Settings_NetworkAdd"]</label>
            <div class="inline-form">
                <input id="new-host" class="input" @bind="_newEntry" placeholder="freshrss.lan" aria-describedby="new-host-hint" required />
                <button type="submit" class="button button-secondary">@T["Settings_NetworkAdd"]</button>
            </div>
            <span id="new-host-hint" class="hint">@T["Settings_NetworkAddHint"]</span>
        </form>
    </section>

</div>

@code {
    private List<string> _errors = [];
    private string? _notice;
    private bool _busy;

    private string? _testRecipient;
    private string? _newEntry;

    // AI provider
    private string? _aiEndpoint;
    private string? _aiModel;
    private string? _aiKey;
    private bool _aiKeySaved;
    private bool _aiLocal = true;
    private bool _aiSummaries = true;
    private bool _aiEnabled = true;

    // Local news
    private string? _searxngUrl;
    private bool _searxngLocked;

    protected override async Task LoadAsync()
    {
        _testRecipient = (await UseAsync<ProfileEditor, Profile>(editor => editor.GetOrCreateAsync(UserId, Closed))).Recipient;
        await LoadAiAsync();
        await LoadNewsAsync();
    }

    private async Task LoadNewsAsync()
    {
        _searxngUrl = await UseAsync<NewsSearchSettingsStore, string?>(store => store.SearxngUrlAsync(Closed));
        _searxngLocked = await UseAsync<NewsSearchSettingsStore, bool>(store => Task.FromResult(store.IsLocked));
    }

    private async Task SaveNewsAsync()
    {
        Clear();
        if (!await UseAsync<NewsSearchSettingsStore, bool>(store => store.SaveAsync(_searxngUrl, UserId, Closed)))
        {
            _errors = [T["Settings_Error_SearxngUrl"]];
            return;
        }

        _notice = string.IsNullOrWhiteSpace(_searxngUrl) ? T["Settings_SearxngOff"] : T["Settings_Saved"];
        await LoadNewsAsync();
    }

    // Tests what is saved, like the AI test: one search for a well-known place.
    private async Task TestNewsAsync()
    {
        Clear();
        _busy = true;
        try
        {
            var term = T["Settings_SearxngTestTerm"].Value;
            switch (await UseAsync<NewsSearchSettingsStore, MorningInk.Application.Sources.SourceResult?>(store => store.TestAsync(term, Closed)))
            {
                case null:
                    _errors = [T["Settings_SearxngNotSet"]];
                    break;
                case MorningInk.Application.Sources.SourceResult.Failure failure:
                    _errors = [T["Settings_SearxngFailed", SourceTexts.Describe(T, failure.Reason, failure.Arguments, failure.Message)]];
                    break;
                case MorningInk.Application.Sources.SourceResult.Success success:
                    _notice = T["Settings_SearxngWorks", success.Articles.Count, term];
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadAiAsync()
    {
        var ai = await UseAsync<MorningInk.Infrastructure.Ai.AiSettingsStore, AiSettings>(store => store.LoadAsync(Closed));
        _aiEndpoint = ai.Endpoint;
        _aiModel = ai.Model;
        _aiKey = null;
        _aiKeySaved = ai.ApiKey is not null;
        _aiLocal = ai.IsLocal;
        _aiSummaries = ai.Summaries;
        _aiEnabled = ai.Enabled;
    }

    private async Task SaveAiAsync()
    {
        Clear();
        var input = new MorningInk.Infrastructure.Ai.AiSettingsInput(_aiEndpoint, _aiModel, _aiKey, _aiLocal, _aiSummaries, _aiEnabled);
        var errors = await UseAsync<MorningInk.Infrastructure.Ai.AiSettingsStore, IReadOnlyList<string>>(store => store.SaveAsync(input, UserId, Closed));
        _errors = errors.Select(field => T[$"Settings_Error_Ai{field}"].Value).ToList();
        if (_errors.Count == 0)
        {
            _notice = T["Settings_Saved"];
            await LoadAiAsync();
        }
    }

    // Tests what is saved, so a test right after typing asks the user to save first.
    private async Task TestAiAsync()
    {
        Clear();
        _busy = true;
        try
        {
            var ai = await UseAsync<MorningInk.Infrastructure.Ai.AiSettingsStore, AiSettings>(store => store.LoadAsync(Closed));
            if (ai.Endpoint is null)
            {
                _errors = [T["Settings_AiNotSet"]];
                return;
            }

            var problem = await AiChat.TestAsync(ai, Closed);
            if (problem is null)
            {
                _notice = T["Settings_AiWorks", ai.Model ?? string.Empty];
            }
            else
            {
                _errors = [T["Settings_AiFailed", problem]];
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void MailSaved(IReadOnlyList<string> errors)
    {
        _errors = [.. errors];
        _notice = errors.Count == 0 ? T["Settings_Saved"].Value : null;
    }

    private async Task SendTestAsync()
    {
        Clear();
        var recipient = _testRecipient?.Trim() ?? string.Empty;
        _busy = true;
        try
        {
            var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            switch (await UseAsync<TestMail, DeliveryResult>(mail => mail.SendAsync(recipient, language, Closed)))
            {
                case DeliveryResult.Failure failure:
                    _errors = [T["Settings_TestFailed", DeliveryTexts.Describe(T, failure)]];
                    break;
                default:
                    _notice = T["Settings_TestSent", recipient];
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddHostAsync()
    {
        Clear();
        if (!string.IsNullOrWhiteSpace(_newEntry))
        {
            await Allowlist.AddAsync(_newEntry, UserId, Closed);
            _notice = T["Sources_Allowed", _newEntry.Trim().ToLowerInvariant()];
            _newEntry = null;
        }
    }

    private async Task RemoveHostAsync(string entry)
    {
        Clear();
        await Allowlist.RemoveAsync(entry, Closed);
        _notice = T["Settings_Saved"];
    }

    private void Clear()
    {
        _notice = null;
        _errors = [];
    }
}
