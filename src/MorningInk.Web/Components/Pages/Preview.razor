@page "/preview"
@rendermode InteractiveServer
@inherits InteractivePage
@using System.Globalization
@using MorningInk.Application.Publishing
@using MorningInk.Application.Scheduling
@using MorningInk.Domain
@using MorningInk.Infrastructure.Ai
@using MorningInk.Infrastructure.Profiles
@inject PreviewStore Previews
@inject TimeProvider Time

<PageTitle>@T["Preview_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <h1>@T["Preview_Title"]</h1>
    <p class="lede">@T["Preview_Lede"]</p>
    @if (_note is not null)
    {
        <div class="alert alert-ok" role="status"><p>@_note</p></div>
    }
</header>

<form class="preview-controls" @onsubmit="BuildAsync">
    @if (_editions.Count > 1)
    {
        <div class="field">
            <label for="edition">@T["Preview_Edition"]</label>
            <select id="edition" class="input" @bind="_editionId">
                @foreach (var edition in _editions)
                {
                    <option value="@edition.Id">@edition.Title</option>
                }
            </select>
        </div>
    }
    @if (_aiAvailable)
    {
        @* Off by default: a model on a CPU can make the preview take minutes. *@
        <label class="checkbox"><input id="with-ai" type="checkbox" @bind="_withAi" /> @T["Preview_WithAi"]</label>
    }
    <button type="submit" class="button" disabled="@_busy">@(_busy ? T["Preview_Building"] : T["Preview_Build"])</button>
</form>

@if (_built is { } built)
{
    <div class="with-sidebar preview">
        @* Sandboxed: the pages may load their style and images from here, but never run anything. *@
        <iframe class="preview-frame" title="@T["Preview_Title"]" sandbox="allow-same-origin" src="/preview/file/@_page?v=@_stamp"></iframe>
        <aside class="sidebar">
            <img class="preview-cover" src="/preview/file/cover.jpg?v=@_stamp" alt="@T["Preview_Cover"]" />
            <div class="row-actions">
                <button type="button" class="link-button" @onclick='() => _page = "title.xhtml"'>@T["Preview_FrontPage"]</button>
                <button type="button" class="link-button" @onclick='() => _page = "nav.xhtml"'>@T["Preview_Contents"]</button>
            </div>
            <details class="preview-log">
                <summary class="link-button">@T["Log_Show"]</summary>
                <IssueLogView Entries="built.Log" Zone="ProfileTimeZone.Find(_editions.Single(e => e.Id == _editionId).TimeZoneId)" />
            </details>
            @if (built.UnavailableSources.Count > 0)
            {
                <p class="hint">@T["Dash_Unavailable"] @string.Join(" · ", built.UnavailableSources.Select(p => $"{p.SourceName}: {SourceTexts.Describe(T, p.Reason, p.Arguments, p.Message)}"))</p>
            }
        </aside>
    </div>
}

@code {
    private IReadOnlyList<Profile> _editions = [];
    private Guid _editionId;
    private bool _aiAvailable;
    private bool _withAi;
    private bool _busy;
    private string? _note;
    private PreviewResult.Built? _built;
    private string _page = "title.xhtml";
    private long _stamp;

    /// <summary>The edition to preview, e.g. from the dashboard; none means the first one.</summary>
    [SupplyParameterFromQuery(Name = "edition")]
    private Guid? Edition { get; set; }

    protected override async Task LoadAsync()
    {
        _editions = await UseAsync<ProfileEditor, IReadOnlyList<Profile>>(editor => editor.ListAsync(UserId, Closed));
        _editionId = _editions.FirstOrDefault(e => e.Id == Edition)?.Id ?? _editions[0].Id;
        var ai = await UseAsync<AiSettingsStore, AiSettings>(store => store.LoadAsync(Closed));
        _aiAvailable = ai is { Enabled: true, Endpoint: not null, Summaries: true };
    }

    private async Task BuildAsync()
    {
        _busy = true;
        _note = null;
        try
        {
            // ProfileEditor.ListAsync only returns the user's own editions, so the chosen id is theirs.
            var id = _editions.Single(e => e.Id == _editionId).Id;
            switch (await UseAsync<IssuePublisher, PreviewResult>(publisher => publisher.PreviewAsync(id, _withAi, Closed)))
            {
                case PreviewResult.Built built:
                    Previews.Put(UserId, built.File);
                    _built = built;
                    _page = "title.xhtml";
                    _stamp = Time.GetUtcNow().ToUnixTimeMilliseconds();
                    _note = T["Preview_State", Clock.Time(T, Time.GetLocalNow())];
                    break;
                case PreviewResult.Empty:
                    _built = null;
                    _note = T["Preview_Empty"];
                    break;
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
