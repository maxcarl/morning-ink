@page "/status"
@rendermode InteractiveServer
@inherits InteractivePage
@using MorningInk.Application.Publishing
@using MorningInk.Application.Scheduling
@using System.Globalization
@using MorningInk.Domain
@using MorningInk.Infrastructure
@using MorningInk.Infrastructure.Cleanup
@using MorningInk.Infrastructure.Persistence
@using MorningInk.Infrastructure.Scheduling
@using MorningInk.Infrastructure.Transfer
@inject DiskUsage Disk
@inject IHostApplicationLifetime Lifetime

<PageTitle>@T["System_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <h1>@T["System_Title"]</h1>
    <p class="lede">@(IsAdmin ? T["System_Lede"] : T["System_LedeOwn"])</p>
    <Messages Notice="@_notice" Error="@_error" />
</header>

@* Everyone sees the jobs of their own editions; an admin those of all users, and storage and backup beside them:
   two columns on wide screens, one below the other on a phone. Lists, not wide tables, so nothing scrolls sideways. *@
<div class="@(IsAdmin ? "columns" : null)">
    <div>
        @if (_view is { } view)
        {
            <section aria-labelledby="running-heading">
                <h2 id="running-heading" class="department">@T["System_Running"]</h2>
                @if (view.Running.Count == 0)
                {
                    <p class="muted">@T["System_NoneRunning"]</p>
                }
                <ul class="rows">
                    @foreach (var job in view.Running)
                    {
                        <li class="row">
                            <div class="row-main">
                                <div class="row-title">@T[$"JobKind_{job.Kind}"]</div>
                                <div class="row-meta">@Who(job) · @T["System_Since", Clock.Time(T, Local(job))]@Zone(job)</div>
                                @if (job.Step is { } step)
                                {
                                    <div class="row-meta">@T[$"IssueStage_{step.Stage}"]@(step.Total > 0 ? $" {step.Done + 1}/{step.Total}" : null)</div>
                                }
                            </div>
                            @if (job.ProfileId is { } profileId)
                            {
                                <div class="row-actions">
                                    <button type="button" class="link-button link-danger" @onclick="() => CancelAsync(profileId)">@T["Dash_Cancel"]<span class="visually-hidden"> – @job.Edition</span></button>
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>

            <section aria-labelledby="planned-heading">
                <h2 id="planned-heading" class="department">@T["System_Planned"]</h2>
                <p class="hint">@T["System_TimeHint"]</p>
                @if (view.Planned.Count == 0)
                {
                    <p class="muted">@T["System_NonePlanned"]</p>
                }
                <ul class="rows">
                    @foreach (var job in view.Planned)
                    {
                        <li class="row">
                            <div class="row-main">
                                <div class="row-title">@Clock.DateAndTime(T, Local(job))@Zone(job)</div>
                                <div class="row-meta">@T[$"JobKind_{job.Kind}"] · @Who(job)</div>
                            </div>
                        </li>
                    }
                </ul>
            </section>
        }

        <section aria-labelledby="config-heading">
            <h2 id="config-heading" class="department">@T["System_Config"]</h2>
            <p class="hint">@(IsAdmin ? T["System_ConfigHintAdmin"] : T["System_ConfigHint"])</p>
            @* A plain form post: the browser downloads the file. *@
            <form class="field" method="post" action="/status/config">
                <AntiforgeryToken />
                <button type="submit" class="button button-secondary">@T["System_ConfigDownload"]</button>
            </form>
            @if (_configUpload is null)
            {
                <div class="field">
                    <label class="label" for="config-file">@T["System_ConfigFile"]</label>
                    <InputFile id="config-file" class="input" accept=".json,application/json" OnChange="PickConfigAsync" aria-describedby="config-hint" />
                    <span id="config-hint" class="hint">@T["System_ConfigImportHint"]</span>
                </div>
            }
            else
            {
                @* It replaces sources and editions, with the issues of editions not in the file: ask once. *@
                <p class="confirm" role="alert">@T["System_ConfigConfirm"]</p>
                <div class="row-actions">
                    <button type="button" class="button" @onclick="ImportConfigAsync">@T["System_ConfigImport"]</button>
                    <button type="button" class="link-button" @onclick="() => _configUpload = null">@T["Confirm_Cancel"]</button>
                </div>
            }
            @if (_configResult is { } result)
            {
                @if (!result.Imported)
                {
                    <p class="status status-error">@T["System_ConfigRefused"]</p>
                }
                <ul class="hint">
                    @foreach (var problem in result.Problems.Concat(result.InstanceProblems))
                    {
                        <li>@ProblemText(problem)</li>
                    }
                    @foreach (var source in result.NeedLogin)
                    {
                        <li>@T["System_ConfigNeedLogin", source]</li>
                    }
                    @foreach (var edition in result.NeedToken)
                    {
                        <li>@T["System_ConfigNeedToken", edition]</li>
                    }
                </ul>
            }
        </section>
    </div>

    @if (IsAdmin)
    {
    <div>
        @if (_storage is { } storage)
        {
            <section aria-labelledby="storage-heading">
                <h2 id="storage-heading" class="department">@T["System_Storage"]</h2>
                <p class="hint">@T["System_StorageHint"]</p>
                @if (storage.LowOnSpace)
                {
                    <p class="status status-warn">@T["System_LowOnSpace"]</p>
                }
                @if (storage.TooLarge)
                {
                    <p class="status status-warn">@T["System_TooLarge"]</p>
                }
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">@T["System_Area"]</th>
                            <th scope="col" class="number">@T["System_Files"]</th>
                            <th scope="col" class="number">@T["System_Size"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var area in storage.Areas)
                        {
                            <tr>
                                <th scope="row">@T[$"StorageArea_{area.Area}"]</th>
                                <td class="number">@area.Files.ToString("N0", CultureInfo.CurrentCulture)</td>
                                <td class="number">@Size(area.Bytes)</td>
                            </tr>
                        }
                        <tr>
                            <th scope="row">@T["System_Total"]</th>
                            <td></td>
                            <td class="number">@Size(storage.TotalBytes)</td>
                        </tr>
                        @if (storage.FreeBytes is { } free)
                        {
                            <tr>
                                <th scope="row">@T["System_Free"]</th>
                                <td></td>
                                <td class="number">@Size(free)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <form @onsubmit="SaveCleanupAsync">
                    <div class="field-row">
                        <div class="field">
                            <label for="cleanup-time">@T["System_CleanupTime"]</label>
                            <input id="cleanup-time" class="input" type="time" @bind="_cleanupAt" readonly="@_cleanupLocked" required aria-describedby="cleanup-hint" />
                        </div>
                        <div class="field">
                            <label for="cleanup-zone">@T["Profile_TimeZone"]</label>
                            <select id="cleanup-zone" class="input" @bind="_cleanupZone" disabled="@_cleanupLocked">
                                @foreach (var zone in TimeZones.All)
                                {
                                    <option value="@zone">@zone</option>
                                }
                            </select>
                        </div>
                    </div>
                    <p id="cleanup-hint" class="hint">@(_cleanupLocked ? T["System_CleanupLocked"] : T["System_CleanupHint"])</p>
                    @if (!_cleanupLocked)
                    {
                        <button type="submit" class="button button-secondary">@T["Settings_Save"]</button>
                    }
                </form>
                <div class="field">
                    <p class="hint" id="clear-images-hint">@T["System_ClearImagesHint"]</p>
                    <button type="button" class="button button-secondary" aria-describedby="clear-images-hint" @onclick="ClearImages">@T["System_ClearImages"]</button>
                </div>
            </section>
        }

        <section aria-labelledby="backup-heading">
            <h2 id="backup-heading" class="department">@T["System_Backup"]</h2>
            <p class="hint">@T["System_BackupHint"]</p>
            @* Plain form posts, not page events: the browser downloads the file, and uploads it as a whole. *@
            <form class="field" method="post" action="/status/backup">
                <AntiforgeryToken />
                <button type="submit" class="button button-secondary">@T["System_BackupDownload"]</button>
            </form>
            @if (_restorePending)
            {
                <p class="status status-warn">@T["System_RestorePending"]</p>
                <div class="row-actions">
                    <button type="button" class="button" aria-describedby="restart-hint" @onclick="Restart">@T["System_Restart"]</button>
                    <button type="button" class="link-button link-danger" @onclick="DiscardAsync">@T["System_RestoreDiscard"]</button>
                </div>
                <p class="hint" id="restart-hint">@T["System_RestartHint"]</p>
            }
            else
            {
                <form class="field" method="post" action="/status/restore" enctype="multipart/form-data">
                    <AntiforgeryToken />
                    <label class="label" for="backup-file">@T["System_RestoreFile"]</label>
                    <div class="inline-form">
                        <input id="backup-file" class="input" type="file" name="@BackupEndpoints.FileField" accept=".db" required aria-describedby="restore-hint" />
                        <button type="submit" class="button button-secondary">@T["System_RestoreUpload"]</button>
                    </div>
                    <span id="restore-hint" class="hint">@T["System_RestoreHint"]</span>
                </form>
            }
        </section>
    </div>
    }
</div>

@code {
    private const double Megabyte = 1024 * 1024;
    private const double MegabytesPerGigabyte = 1024;

    private JobsView? _view;
    private StorageReport? _storage;
    private string? _notice;
    private string? _error;
    private bool _restorePending;
    private TimeOnly _cleanupAt;
    private string _cleanupZone = string.Empty;
    private bool _cleanupLocked;
    private byte[]? _configUpload;
    private ConfigImport? _configResult;

    /// <summary>How the restore upload went, set by <see cref="BackupEndpoints"/> on its way back here.</summary>
    [SupplyParameterFromQuery(Name = BackupEndpoints.RestoreQuery)]
    private string? Restore { get; set; }

    protected override async Task LoadAsync()
    {
        if (_view is null && Restore is { } outcome)
        {
            // Only names this page knows are shown; anything else in the URL is ignored.
            _notice = outcome == BackupEndpoints.Staged ? T["System_RestoreStaged"].Value : null;
            _error = Enum.TryParse<RestoreProblem>(outcome, out var problem) && Enum.IsDefined(problem) ? T[$"RestoreProblem_{problem}"].Value : null;
        }

        _view = await UseAsync<JobsOverview, JobsView>(jobs => jobs.LoadAsync(UserId, IsAdmin, Closed));
        if (IsAdmin)
        {
            _restorePending = await UseAsync<DatabaseBackups, bool>(backups => Task.FromResult(backups.RestorePending));
            _storage = Disk.Measure();
            if (_cleanupZone.Length == 0)
            {
                // Once: the five-second refresh must not overwrite what the admin is typing.
                var cleanup = await UseAsync<CleanupSchedule, CleanupTime>(schedule => schedule.GetAsync(Closed));
                (_cleanupAt, _cleanupZone) = (cleanup.At, cleanup.TimeZoneId);
                _cleanupLocked = await UseAsync<CleanupSchedule, bool>(schedule => Task.FromResult(schedule.IsLocked));
            }
        }
    }

    // How often the jobs are asked again while the page is open: often enough to watch a run move on, cheap since
    // Quartz answers from memory.
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromSeconds(5);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Prerendering never gets here; the first interactive render starts the loop.
        if (!firstRender)
        {
            return;
        }

        using var timer = new PeriodicTimer(RefreshEvery);
        try
        {
            while (await timer.WaitForNextTickAsync(Closed))
            {
                _view = await UseAsync<JobsOverview, JobsView>(jobs => jobs.LoadAsync(UserId, IsAdmin, Closed));
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // The tab closed.
        }
    }

    private async Task CancelAsync(Guid profileId)
    {
        _error = null;
        _notice = await UseAsync<JobsOverview, bool>(jobs => jobs.CancelAsync(UserId, IsAdmin, profileId, Closed)) ? T["Dash_CancelRequested"] : T["Dash_NothingToCancel"];
        await LoadAsync();
    }

    // The admin parts are only rendered for admins; the checks keep it so for any event that reaches the page.
    private async Task DiscardAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        await UseAsync<DatabaseBackups>(backups =>
        {
            backups.DiscardRestore();
            return Task.CompletedTask;
        });
        _restorePending = false;
        (_notice, _error) = (T["System_RestoreDiscarded"].Value, null);
    }

    // Docker starts the container again (restart: unless-stopped), and the start applies the waiting backup.
    private void Restart()
    {
        if (!IsAdmin)
        {
            return;
        }

        (_notice, _error) = (T["System_Restarting"].Value, null);
        Lifetime.StopApplication();
    }

    // Read at once and kept until confirmed: the browser's file is gone once the input re-renders.
    private async Task PickConfigAsync(InputFileChangeEventArgs e)
    {
        _configResult = null;
        (_notice, _error) = (null, null);
        try
        {
            // The browser streams at most one byte past the limit; the import refuses anything larger.
            await using var file = e.File.OpenReadStream(ConfigTransfer.MaxFileBytes + 1, Closed);
            using var copy = new MemoryStream();
            await file.CopyToAsync(copy, Closed);
            _configUpload = copy.ToArray();
        }
        catch (IOException)
        {
            _error = T["System_ConfigTooLarge"];
        }
    }

    private async Task ImportConfigAsync()
    {
        if (_configUpload is not { } upload)
        {
            return;
        }

        _configUpload = null;
        using var stream = new MemoryStream(upload);
        _configResult = await UseAsync<ConfigTransfer, ConfigImport>(transfer => transfer.ImportAsync(UserId, IsAdmin, stream, Closed));
        _notice = _configResult.Imported ? T["System_ConfigImported"].Value : null;
        _view = await UseAsync<JobsOverview, JobsView>(jobs => jobs.LoadAsync(UserId, IsAdmin, Closed));
    }

    // The common reasons in words; any other is a field of a form, named as the file names it.
    private string ProblemText(ConfigProblem problem)
    {
        var reason = T[$"ConfigProblem_{problem.Code}"];
        return T["System_ConfigProblem", problem.Item, reason.ResourceNotFound ? problem.Code : reason.Value];
    }

    private async Task SaveCleanupAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        var saved = await UseAsync<CleanupSchedule, bool>(schedule => schedule.SaveAsync(new CleanupTime(_cleanupAt, _cleanupZone), Closed));
        _notice = saved ? T["System_CleanupSaved", Clock.Time(T, _cleanupAt), _cleanupZone].Value : null;
        _error = saved ? null : T["System_CleanupInvalid"].Value;
        _view = await UseAsync<JobsOverview, JobsView>(jobs => jobs.LoadAsync(UserId, IsAdmin, Closed));
    }

    private void ClearImages()
    {
        if (!IsAdmin)
        {
            return;
        }

        var deleted = Disk.ClearImages();
        _notice = deleted is { } count ? T["System_ImagesCleared", count].Value : null;
        _error = deleted is null ? T["System_ImagesBusy"].Value : null;
        _storage = Disk.Measure();
    }

    // Each time in the zone it was planned in, its edition's, so a delivery set for 6:00 reads 6:00.
    private string ZoneOf(JobRow job) => job.TimeZoneId ?? _view?.TimeZoneId ?? TimeZoneInfo.Utc.Id;

    private DateTimeOffset Local(JobRow job) => TimeZoneInfo.ConvertTime(job.At, ProfileTimeZone.Find(ZoneOf(job)));

    // With editions in several zones the zone is named, or "7:00" after "8:00" would look out of order.
    private string? Zone(JobRow job) =>
        _view is { } view && view.Running.Concat(view.Planned).Select(ZoneOf).Distinct().Skip(1).Any() ? $" ({ZoneOf(job)})" : null;

    // "0.4 MB", "1.2 GB": enough to see what grows.
    private static string Size(long bytes)
    {
        var megabytes = bytes / Megabyte;
        return megabytes >= MegabytesPerGigabyte
            ? string.Create(CultureInfo.CurrentCulture, $"{megabytes / MegabytesPerGigabyte:0.0} GB")
            : string.Create(CultureInfo.CurrentCulture, $"{megabytes:0.0} MB");
    }

    // The owner only for an admin; everyone else sees only their own.
    private string Who(JobRow job) => job.Edition is null ? "–" : IsAdmin ? $"{job.Edition} · {job.Owner}" : job.Edition;
}
