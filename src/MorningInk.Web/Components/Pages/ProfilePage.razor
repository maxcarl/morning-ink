@page "/profile"
@page "/profile/{ProfileId:guid}"
@rendermode InteractiveServer
@inherits InteractivePage
@using System.Globalization
@using MorningInk.Application.Notifications
@using MorningInk.Domain
@using MorningInk.Infrastructure.Profiles
@using MorningInk.Infrastructure.Sources
@inject NavigationManager Navigation

<PageTitle>@T["Profile_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    @if (_profile is not null)
    {
    <div class="page-title-row">
        <h1>@T["Profile_Title"]</h1>
        <a class="button button-secondary button-small" href="/preview?edition=@_profile.Id">@T["Preview_Open"]</a>
    </div>
    <p class="lede">
        @(!_profile.SendByEmail
            ? T["Profile_LedeFetch", _profile.Title, DaysText(_profile), Clock.Time(T, _profile.DeliveryTime), _profile.TimeZoneId]
            : string.IsNullOrEmpty(_profile.Recipient)
            ? T["Profile_LedeNoRecipient", _profile.Title, DaysText(_profile), Clock.Time(T, _profile.DeliveryTime), _profile.TimeZoneId]
            : T["Profile_Lede", _profile.Title, DaysText(_profile), Clock.Time(T, _profile.DeliveryTime), _profile.TimeZoneId, _profile.Recipient])
    </p>
    @* One tab per edition, like the sections of a paper; a new one starts as a copy of the first one's delivery. *@
    <nav class="editions" aria-label="@T["Profile_Editions"]">
        @foreach (var edition in _editions)
        {
            <a href="/profile/@edition.Id" aria-current="@(edition.Id == _profile.Id ? "page" : null)">@edition.Title</a>
        }
        <button type="button" class="link-button" @onclick="CreateEditionAsync">+ @T["Profile_NewEdition"]</button>
    </nav>
    }
    else
    {
        <h1>@T["Profile_Title"]</h1>
    }
    <Messages Notice="@_notice" Errors="_errors" />
</header>

@* One column in reading order: what is in the paper, what it prefers, when and where it goes. *@
<div class="columns">
    <div>
        <section aria-labelledby="sections-heading">
            <h2 id="sections-heading" class="department">@T["Profile_Sections"]</h2>
            <p class="hint">@T["Profile_SectionsHint"]</p>
            @if (_sections.Count == 0)
            {
                <p class="muted">@T["Profile_NoSections"]</p>
            }
            <ul class="rows">
                @for (var i = 0; i < _sections.Count; i++)
                {
                    var index = i;
                    var item = _sections[i];
                    var open = item.Id == _openId;
                    @* Drag a row onto another to move it there. The arrows in the editor do the same by keyboard. *@
                    <li @key="item.Id" draggable="@(open ? "false" : "true")" class="@(item.Id == _overId ? "drop-target" : null)"
                        @ondragstart="() => _dragId = item.Id" @ondragenter="() => _overId = item.Id" @ondragend="() => _overId = _dragId = null"
                        @ondragover:preventDefault @ondrop="() => DropAsync(index)">
                        <div class="row">
                            <span class="drag-handle" aria-hidden="true">⋮⋮</span>
                            <div class="row-main">
                                <div class="row-title">@item.Name</div>
                                <div class="row-meta">@Summary(item)</div>
                            </div>
                            <button type="button" class="link-button" aria-expanded="@(open ? "true" : "false")" aria-controls="editor-@item.Id" @onclick="() => Toggle(item)">
                                @(open ? T["Profile_Close"] : T["Profile_Edit"])<span class="visually-hidden"> – @item.Name</span>
                            </button>
                        </div>
                        @if (open)
                        {
                            <form id="editor-@item.Id" class="editor-body" @onsubmit="() => SaveSectionAsync(item.Id)">
                                <fieldset class="field">
                                    <legend class="label">@T["Profile_SectionSources"]</legend>
                                    @if (_sources.Count == 0)
                                    {
                                        <p class="hint"><a href="/sources">@T["Profile_NoSources"]</a></p>
                                    }
                                    @if (_sources.Count > SearchFrom)
                                    {
                                        <div class="search">
                                            <label class="visually-hidden" for="find-@item.Id">@T["Profile_FindSource"]</label>
                                            <input id="find-@item.Id" class="input" type="search" placeholder="@T["Profile_FindSource"]" @bind="_find" @bind:event="oninput" />
                                        </div>
                                    }
                                    <div class="choices">
                                        @foreach (var source in Choices())
                                        {
                                            <label class="checkbox" @key="source.Id"><input type="checkbox" checked="@_picked.Contains(source.Id)" @onchange="() => Pick(source.Id)" /> @source.Name</label>
                                        }
                                    </div>
                                </fieldset>
                                <div class="inline-form field">
                                    <div class="row-main">
                                        <label class="label" for="name-@item.Id">@T["Profile_SectionName"]</label>
                                        <input id="name-@item.Id" class="input" @bind="_name" required />
                                    </div>
                                    <div>
                                        <label class="label" for="max-@item.Id">@T["Profile_MaxArticles"]</label>
                                        <input id="max-@item.Id" class="input" @bind="_max" inputmode="numeric" placeholder="@T["Profile_Unlimited"]" />
                                    </div>
                                </div>
                                <div class="row-actions">
                                    @if (item.Id == _confirmId)
                                    {
                                        <p class="confirm" role="alert">@T["Confirm_Delete", item.Name]</p>
                                        <button type="button" class="button button-small" @onclick="() => DeleteAsync(item.Id)">@T["Confirm_Yes"]</button>
                                        <button type="button" class="link-button" @onclick="() => _confirmId = null">@T["Confirm_Cancel"]</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="button button-small">@T["Profile_Save"]<span class="visually-hidden"> – @item.Name</span></button>
                                        @if (index > 0)
                                        {
                                            <button type="button" class="button button-secondary button-small" @onclick="() => MoveAsync(item.Id, index - 1)">@T["Profile_MoveUp"]<span class="visually-hidden"> – @item.Name</span></button>
                                        }
                                        @if (index < _sections.Count - 1)
                                        {
                                            <button type="button" class="button button-secondary button-small" @onclick="() => MoveAsync(item.Id, index + 1)">@T["Profile_MoveDown"]<span class="visually-hidden"> – @item.Name</span></button>
                                        }
                                        <button type="button" class="link-button link-danger" @onclick="() => _confirmId = item.Id">@T["Profile_DeleteSection"]<span class="visually-hidden"> – @item.Name</span></button>
                                    }
                                </div>
                            </form>
                        }
                    </li>
                }
            </ul>
            <form @onsubmit="AddSectionAsync" class="field">
                <label class="label" for="new-section">@T["Profile_AddSection"]</label>
                <div class="inline-form">
                    <input id="new-section" class="input" @bind="_newSection" required />
                    <button type="submit" class="button button-secondary">@T["Profile_AddSection"]</button>
                </div>
            </form>
        </section>

        <section aria-labelledby="interests-heading">
            <h2 id="interests-heading" class="department">@T["Interests_Title"]</h2>
            <p class="hint">@T["Interests_Hint"]</p>
            <details class="explainer">
                <summary>@T["Interests_How"]</summary>
                <p>@T["Interests_HowTopic"]</p>
                <p>@T["Interests_HowKeywords"]</p>
                <p>@T["Interests_HowWeight"]</p>
                <p>@T["Interests_HowExamples"]</p>
                <ul>
                    <li>@T["Interests_ExampleFootball"]</li>
                    <li>@T["Interests_ExampleCelebrities"]</li>
                </ul>
                <p>@T["Interests_HowSources"]</p>
            </details>
            <form @onsubmit="SaveInterestsAsync">
                @for (var i = 0; i < _interests.Count; i++)
                {
                    var draft = _interests[i];
                    var index = i;
                    <div class="interest inline-form field" @key="draft">
                        <div>
                            <label class="label" for="interest-topic-@index">@T["Interests_Topic"]</label>
                            <input id="interest-topic-@index" class="input" @bind="draft.Topic" placeholder="@T["Interests_TopicPlaceholder"]" />
                        </div>
                        <div class="row-main">
                            <label class="label" for="interest-keywords-@index">@T["Interests_Keywords"]</label>
                            <input id="interest-keywords-@index" class="input" @bind="draft.Keywords" placeholder="@T["Interests_KeywordsPlaceholder"]" />
                        </div>
                        <div>
                            <label class="label" for="interest-weight-@index">@T["Interests_Weight"]</label>
                            <select id="interest-weight-@index" class="input" @bind="draft.Weight">
                                @foreach (var weight in new[] { InterestWeight.StrongPrefer, InterestWeight.Prefer, InterestWeight.Less, InterestWeight.Hide })
                                {
                                    <option value="@weight">@T[$"Interests_Weight_{weight}"]</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="link-button link-danger" @onclick="() => _interests.RemoveAt(index)">@T["Interests_Remove"]<span class="visually-hidden"> – @draft.Topic</span></button>
                    </div>
                }
                <div class="row-actions">
                    <button type="button" class="button button-secondary button-small" @onclick="() => _interests.Add(new InterestDraft())">+ @T["Interests_Add"]</button>
                    <button type="submit" class="button button-small">@T["Interests_Save"]</button>
                </div>
            </form>
        </section>
    </div>

    <div>
        <section aria-labelledby="settings-heading">
            <h2 id="settings-heading" class="visually-hidden">@T["Profile_Settings"]</h2>
            <form @onsubmit="SaveSettingsAsync">
                <h3 class="department">@T["Profile_GroupPaper"]</h3>
                <div class="field-row">
                    <div class="field">
                        <label for="title">@T["Profile_NewspaperTitle"]</label>
                        <input id="title" class="input" @bind="_title" required />
                    </div>
                    <div class="field">
                        <label for="country">@T["Country"]</label>
                        <CountrySelect Id="country" @bind-Selected="_country" DescribedBy="country-hint" />
                        <span id="country-hint" class="hint">@T["Profile_CountryHint"]</span>
                    </div>
                </div>
                <div class="field">
                    <label for="region">@T["Profile_Region"]</label>
                    <input id="region" class="input" @bind="_region" aria-describedby="region-hint" />
                    <span id="region-hint" class="hint">@T["Profile_RegionHint"]</span>
                </div>

                <h3 class="department form-group">@T["Profile_GroupSchedule"]</h3>
                <div class="field-row">
                    <div class="field">
                        <label for="time">@T["Profile_DeliveryTime"]</label>
                        <input id="time" class="input" type="time" @bind="_time" required />
                    </div>
                    <div class="field">
                        <label for="zone">@T["Profile_TimeZone"]</label>
                        <select id="zone" class="input" @bind="_zone">
                            @foreach (var zone in TimeZones.All)
                            {
                                <option value="@zone">@zone</option>
                            }
                        </select>
                    </div>
                </div>
                <fieldset class="field">
                    <legend class="label">@T["Profile_Days"]</legend>
                    <div class="weekdays">
                        @foreach (var day in Week)
                        {
                            <label class="checkbox"><input type="checkbox" checked="@_days.Contains(day)" @onchange="() => ToggleDay(day)" /> @CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[(int)day]</label>
                        }
                    </div>
                </fieldset>
                <div class="field">
                    <label for="lead">@T["Profile_LeadTime"]</label>
                    <select id="lead" class="input" @bind="_leadMinutes" aria-describedby="lead-hint">
                        @foreach (var minutes in LeadChoices)
                        {
                            <option value="@minutes">@LeadText(minutes)</option>
                        }
                    </select>
                    <span id="lead-hint" class="hint">@T["Profile_LeadTimeHint"]</span>
                </div>

                <h3 class="department form-group">@T["Profile_Delivery"]</h3>
                <fieldset class="field">
                    <legend class="visually-hidden">@T["Profile_Delivery"]</legend>
                    <div class="choices">
                        <label class="checkbox"><input id="delivery-email" type="radio" name="delivery" checked="@_sendByEmail" @onchange="() => _sendByEmail = true" /> @T["Profile_DeliveryEmail"]</label>
                        <label class="checkbox"><input id="delivery-fetch" type="radio" name="delivery" checked="@(!_sendByEmail)" @onchange="() => _sendByEmail = false" aria-describedby="delivery-fetch-hint" /> @T["Profile_DeliveryFetch"]</label>
                    </div>
                    <span id="delivery-fetch-hint" class="hint">@T["Profile_DeliveryFetchHint"]</span>
                </fieldset>
                @if (_sendByEmail)
                {
                    <div class="field">
                        <label for="recipient">@T["Profile_Recipient"]</label>
                        <input id="recipient" class="input" @bind="_recipient" type="text" inputmode="email" spellcheck="false" autocapitalize="none" autocomplete="off" @attributes="PasswordManagers.Ignore" aria-describedby="recipient-hint" required />
                        <span id="recipient-hint" class="hint">@T["Profile_RecipientHint"]</span>
                    </div>
                }
                <button type="submit" class="button">@T["Profile_Save"]</button>
            </form>
        </section>

        <section aria-labelledby="notify-heading">
            <h2 id="notify-heading" class="department">@T["Notify_Title"]</h2>
            <p class="hint">@T["Notify_Hint"]</p>
            <form @onsubmit="SaveNotificationAsync" aria-labelledby="notify-heading">
                <div class="field">
                    <label for="notify-channel">@T["Notify_Channel"]</label>
                    <select id="notify-channel" class="input" @bind="_notifyChannel">
                        @foreach (var channel in Enum.GetValues<NotificationChannel>())
                        {
                            <option value="@channel">@T[$"Notify_Channel_{channel}"]</option>
                        }
                    </select>
                </div>
                @if (_notifyChannel != NotificationChannel.None)
                {
                    <div class="field">
                        <label for="notify-target">@T[$"Notify_Target_{_notifyChannel}"]</label>
                        <input id="notify-target" class="input" type="text" spellcheck="false" autocapitalize="none" autocomplete="off" @attributes="PasswordManagers.Ignore" @bind="_notifyTarget" aria-describedby="notify-target-hint" required />
                        <span id="notify-target-hint" class="hint">@T[$"Notify_TargetHint_{_notifyChannel}"]</span>
                    </div>
                    @if (_notifyChannel != NotificationChannel.Email)
                    {
                        <div class="field">
                            <label for="notify-secret">@T[$"Notify_Secret_{_notifyChannel}"]</label>
                            @* Never filled in from storage, like the mail password. *@
                            <input id="notify-secret" class="input" type="password" autocomplete="new-password" @attributes="PasswordManagers.Ignore" @bind="_notifySecret" aria-describedby="notify-secret-hint" />
                            <span id="notify-secret-hint" class="hint">@(_notifySecretSaved ? T["Notify_SecretSaved"] : T[$"Notify_SecretHint_{_notifyChannel}"])</span>
                        </div>
                    }
                }
                <div class="row-actions">
                    <button type="submit" class="button">@T["Profile_Save"]</button>
                    @if (_profile?.NotifyChannel is not (null or NotificationChannel.None))
                    {
                        <button type="button" class="button button-secondary" disabled="@_notifyBusy" @onclick="TestNotificationAsync">@T["Notify_Test"]</button>
                    }
                </div>
            </form>
            @if (_editions.Count > 1 && _profile is not null)
            {
                @* A user always keeps one edition, so the last one has no delete. *@
                <div class="row-actions edition-delete">
                    @if (_confirmEdition)
                    {
                        <p class="confirm" role="alert">@T["Confirm_Delete", _profile.Title] @T["Profile_DeleteEditionHint"]</p>
                        <button type="button" class="button button-small" @onclick="DeleteEditionAsync">@T["Confirm_Yes"]</button>
                        <button type="button" class="link-button" @onclick="() => _confirmEdition = false">@T["Confirm_Cancel"]</button>
                    }
                    else
                    {
                        <button type="button" class="link-button link-danger" @onclick="() => _confirmEdition = true">@T["Profile_DeleteEdition"]</button>
                    }
                </div>
            }
        </section>
    </div>
</div>

@code {
    // Up to this many sources, the list is short enough to scan without a search field.
    private const int SearchFrom = 8;

    private Profile? _profile;
    private IReadOnlyList<Profile> _editions = [];
    private Guid? _shownFor;
    private bool _confirmEdition;
    private List<Section> _sections = [];
    private IReadOnlyList<Source> _sources = [];
    private List<string> _errors = [];
    private string? _notice;

    // Drag and drop
    private Guid? _dragId;
    private Guid? _overId;

    // The open section editor: only one at a time, so one set of fields.
    private Guid? _openId;
    private Guid? _confirmId;
    private string _name = string.Empty;
    private string? _max;
    private string _find = string.Empty;
    private HashSet<Guid> _picked = [];
    private HashSet<Guid> _pinned = [];

    private string _newSection = string.Empty;

    // Settings
    private string _title = string.Empty;
    private string _recipient = string.Empty;
    private bool _sendByEmail = true;
    private TimeOnly _time;
    private HashSet<DayOfWeek> _days = [];
    private List<InterestDraft> _interests = [];
    private int _leadMinutes;

    // A slow AI on a CPU needs hours; more than four is not worth offering.
    private static readonly int[] LeadChoices = [0, 30, 60, 120, 180, 240];
    private string _zone = string.Empty;
    private string? _country;
    private string? _region;

    // Notification
    private NotificationChannel _notifyChannel;
    private string? _notifyTarget;
    private string? _notifySecret;
    private bool _notifySecretSaved;
    private bool _notifyBusy;

    protected override async Task LoadAsync()
    {
        _sources = await UseAsync<SourceCatalog, IReadOnlyList<Source>>(catalog => catalog.ListAsync(UserId, Closed));
        await ReloadAsync();
        var profile = _profile!; // ! is safe: ReloadAsync just set it
        _title = profile.Title;
        _recipient = profile.Recipient;
        _sendByEmail = profile.SendByEmail;
        _time = profile.DeliveryTime;
        _days = profile.Days.Count == 0 ? [.. Enum.GetValues<DayOfWeek>()] : [.. profile.Days];
        _leadMinutes = (int)profile.LeadTime.TotalMinutes;
        _zone = profile.TimeZoneId;
        _country = profile.Country;
        _confirmEdition = false;
        _shownFor = ProfileId;
        _interests = profile.Interests.Select(i => new InterestDraft { Topic = i.Topic, Keywords = string.Join(", ", i.Keywords), Weight = i.Weight }).ToList();
        _region = profile.Region;
        LoadNotification(profile);
    }

    private void LoadNotification(Profile profile)
    {
        _notifyChannel = profile.NotifyChannel;
        _notifyTarget = profile.NotifyTarget;
        _notifySecret = null;
        _notifySecretSaved = profile.NotifySecret is not null;
    }

    /// <summary>The edition to show; none means the first one.</summary>
    [Parameter]
    public Guid? ProfileId { get; set; }

    // The week as the user's culture starts it, e.g. Monday first in Germany.
    private static IEnumerable<DayOfWeek> Week => Enumerable.Range(0, 7).Select(i => (DayOfWeek)(((int)CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek + i) % 7));

    // A tab click keeps this page and only changes the parameter, so the edition is loaded again here.
    protected override async Task OnParametersSetAsync()
    {
        if (_profile is not null && ProfileId != _shownFor)
        {
            _openId = _confirmId = null;
            Clear();
            await LoadAsync();
        }
    }

    private async Task ReloadAsync()
    {
        _editions = await UseAsync<ProfileEditor, IReadOnlyList<Profile>>(editor => editor.ListAsync(UserId, Closed));
        var wanted = _profile?.Id ?? ProfileId;
        if (ProfileId != _shownFor)
        {
            wanted = ProfileId;
        }

        _profile = _editions.FirstOrDefault(p => p.Id == wanted) ?? _editions[0];
        _sections = [.. _profile.Sections.OrderBy(s => s.Position)];
    }

    private string DaysText(Profile profile) => profile.Days.Count == 0
        ? T["Profile_EveryDay"]
        : T["Profile_OnDays", string.Join(", ", Week.Where(profile.Days.Contains).Select(d => CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames[(int)d]))];

    private string LeadText(int minutes) => minutes switch
    {
        0 => T["Profile_LeadNone"],
        < 60 => T["Profile_LeadMinutes", minutes],
        _ => T["Profile_LeadHours", minutes / 60],
    };

    private async Task SaveInterestsAsync()
    {
        Clear();

        // Rows left empty are dropped, so adding one by mistake does not block saving.
        var interests = _interests
            .Where(d => !string.IsNullOrWhiteSpace(d.Topic) || !string.IsNullOrWhiteSpace(d.Keywords))
            .Select(d => new Interest { Topic = d.Topic, Keywords = [.. SourceSettings.ParseKeywords(d.Keywords)], Weight = d.Weight })
            .ToList();
        var id = _profile!.Id; // ! is safe: the form only shows with a loaded edition
        if (!await UseAsync<ProfileEditor, bool>(editor => editor.SaveInterestsAsync(UserId, id, interests, Closed)))
        {
            _errors = [T["Interests_Invalid"]];
            return;
        }

        _notice = T["Profile_Saved"];
        await ReloadAsync();
    }

    // An interest as edited: keywords as typed, separated by commas.
    private sealed class InterestDraft
    {
        public string Topic { get; set; } = string.Empty;

        public string Keywords { get; set; } = string.Empty;

        public InterestWeight Weight { get; set; } = InterestWeight.Prefer;
    }

    private void ToggleDay(DayOfWeek day)
    {
        if (!_days.Remove(day))
        {
            _days.Add(day);
        }
    }

    private async Task CreateEditionAsync()
    {
        var created = await UseAsync<ProfileEditor, Profile>(editor => editor.CreateAsync(UserId, T["Profile_NewEdition"], Closed));
        Navigation.NavigateTo($"/profile/{created.Id}");
    }

    private async Task DeleteEditionAsync()
    {
        var id = _profile!.Id; // ! is safe: the button only shows with a loaded profile
        if (await UseAsync<ProfileEditor, bool>(editor => editor.DeleteAsync(UserId, id, Closed)))
        {
            Navigation.NavigateTo("/profile");
        }
    }

    private void Toggle(Section section)
    {
        _confirmId = null;
        if (_openId == section.Id)
        {
            _openId = null;
            return;
        }

        _openId = section.Id;
        _name = section.Name;
        _max = section.MaxArticles?.ToString(CultureInfo.InvariantCulture);
        _find = string.Empty;
        _picked = [.. section.Sources.Select(s => s.Id)];
        _pinned = [.. _picked];
    }

    private void Pick(Guid id)
    {
        if (!_picked.Remove(id))
        {
            _picked.Add(id);
        }
    }

    // Sources ticked when the editor opened stay on top and are never filtered away, so they do not jump while ticking.
    private IEnumerable<Source> Choices()
    {
        var pinned = _sources.Where(s => _pinned.Contains(s.Id));
        var others = _sources.Where(s => !_pinned.Contains(s.Id));
        if (!string.IsNullOrWhiteSpace(_find))
        {
            others = others.Where(s => s.Name.Contains(_find.Trim(), StringComparison.CurrentCultureIgnoreCase));
        }

        return pinned.Concat(others);
    }

    private string Summary(Section section)
    {
        var parts = new List<string>
        {
            section.Sources.Count == 0 ? T["Profile_SectionEmpty"] : string.Join(", ", section.Sources.Select(s => s.Name)),
        };
        if (section.MaxArticles is { } max)
        {
            parts.Add(T["Profile_SectionMax", max]);
        }

        return string.Join(" · ", parts);
    }

    private async Task SaveSectionAsync(Guid id)
    {
        Clear();
        int? limit = null;
        if (!string.IsNullOrWhiteSpace(_max))
        {
            if (!int.TryParse(_max, NumberStyles.None, CultureInfo.InvariantCulture, out var parsed))
            {
                _errors = [T["Profile_SectionInvalid"]];
                return;
            }

            limit = parsed;
        }

        // Ids that are not the user's own sources are dropped by the editor.
        if (!await UseAsync<ProfileEditor, bool>(editor => editor.SaveSectionAsync(UserId, id, _name, limit, [.. _picked], Closed)))
        {
            _errors = [T["Profile_SectionInvalid"]];
            return;
        }

        _notice = T["Profile_Saved"];
        _openId = null;
        await ReloadAsync();
    }

    private async Task DropAsync(int index)
    {
        if (_dragId is { } id)
        {
            await MoveAsync(id, index);
        }

        _dragId = _overId = null;
    }

    private async Task MoveAsync(Guid id, int index)
    {
        Clear();
        await UseAsync<ProfileEditor, bool>(editor => editor.MoveSectionAsync(UserId, id, index, Closed));
        await ReloadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        Clear();
        await UseAsync<ProfileEditor, bool>(editor => editor.DeleteSectionAsync(UserId, id, Closed));
        _confirmId = _openId = null;
        _notice = T["Profile_Saved"];
        await ReloadAsync();
    }

    private async Task AddSectionAsync()
    {
        Clear();
        if (!await UseAsync<ProfileEditor, bool>(editor => editor.AddSectionAsync(UserId, _profile!.Id, _newSection, Closed)))
        {
            _errors = [T["Profile_SectionInvalid"]];
            return;
        }

        _newSection = string.Empty;
        await ReloadAsync();
    }

    private async Task SaveSettingsAsync()
    {
        Clear();
        var errors = await UseAsync<ProfileEditor, IReadOnlyList<string>>(editor => editor.SaveSettingsAsync(
            UserId, _profile!.Id, new ProfileSettings(_title, _recipient, _time.ToString("HH:mm", CultureInfo.InvariantCulture), _zone, _region, _country, [.. _days], TimeSpan.FromMinutes(_leadMinutes), _sendByEmail), Closed));
        _errors = errors.Select(field => T[$"Profile_Error_{field}"].Value).ToList();
        if (_errors.Count == 0)
        {
            _notice = T["Profile_Saved"];
            await ReloadAsync();
        }
    }

    private async Task SaveNotificationAsync()
    {
        Clear();
        var settings = new NotificationSettings(_notifyChannel, _notifyTarget, _notifySecret);
        var errors = await UseAsync<ProfileEditor, IReadOnlyList<string>>(editor => editor.SaveNotificationAsync(UserId, _profile!.Id, settings, Closed)); // ! is safe: the form only shows once the profile is loaded
        _errors = errors.Select(field => T[$"Profile_Error_{field}"].Value).ToList();
        if (_errors.Count == 0)
        {
            _notice = T["Profile_Saved"];
            await ReloadAsync();
            LoadNotification(_profile!); // ! is safe: ReloadAsync always sets it
        }
    }

    // Tests what is saved, like the AI test, so the token never has to stay in the form.
    private async Task TestNotificationAsync()
    {
        Clear();
        if (_profile is not { NotifyTarget: { } target } profile)
        {
            return;
        }

        _notifyBusy = true;
        try
        {
            var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            var problem = await UseAsync<INotifier, string?>(notifier => notifier.NotifyAsync(
                new NotificationTarget(profile.NotifyChannel, target, profile.NotifySecret), new Notice(profile.Title, 0, 0, null, language, IsTest: true), Closed));
            var channel = T[$"Notify_Channel_{profile.NotifyChannel}"].Value;
            if (problem is null)
            {
                _notice = T["Notify_TestSent", channel];
            }
            else
            {
                _errors = [T["Notify_TestFailed", channel, problem]];
            }
        }
        finally
        {
            _notifyBusy = false;
        }
    }

    private void Clear()
    {
        _notice = null;
        _errors = [];
    }
}
