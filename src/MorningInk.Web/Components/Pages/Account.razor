@page "/account"
@inject UserDirectory Users
@inject SignInManager<AppUser> SignInManager
@inject ReaderAccess Readers

@* A plain form, not an interactive page: after the change the sign-in cookie must be issued anew, which needs a real request. *@
<PageTitle>@T["Account_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <h1>@T["Account_Title"]</h1>
    <p class="lede">@T["Account_Lede", HttpContext.User.Identity?.Name ?? string.Empty]</p>
    <Messages Notice="@_notice" Errors="_errors" />
</header>

<div class="columns">
    <div>
        <section aria-labelledby="password-heading">
            <h2 id="password-heading" class="department">@T["Account_ChangePassword"]</h2>
            <EditForm Model="Input" FormName="password" OnSubmit="ChangeAsync" method="post">
                <div class="field-row">
                    <div class="field">
                        <label for="current-password">@T["Account_CurrentPassword"]</label>
                        <InputText id="current-password" type="password" class="input" @bind-Value="Input.Current" autocomplete="current-password" required />
                    </div>
                    <div class="field">
                        <label for="new-password">@T["Account_NewPassword"]</label>
                        <InputText id="new-password" type="password" class="input" @bind-Value="Input.New" autocomplete="new-password" aria-describedby="new-password-hint" required />
                        <span id="new-password-hint" class="hint">@T["Users_StartPasswordHint"]</span>
                    </div>
                </div>
                <button type="submit" class="button">@T["Account_Save"]</button>
            </EditForm>
        </section>
    </div>

    <div>
        <section aria-labelledby="reader-heading">
            <h2 id="reader-heading" class="department">@T["Account_Reader"]</h2>
            <p class="hint">@T["Account_ReaderHint"]</p>
            <dl class="facts">
                <div><dt>@T["Account_ReaderCatalog"]</dt><dd><code>@CatalogUrl</code></dd></div>
                <div><dt>@T["Login_UserName"]</dt><dd><code>@HttpContext.User.Identity?.Name</code></dd></div>
                <div>
                    <dt>@T["Account_ReaderPassword"]</dt>
                    <dd>
                        @if (_readerPassword is not null)
                        {
                            <code id="reader-password">@_readerPassword</code>
                        }
                        else
                        {
                            @(_hasReaderPassword ? T["Account_ReaderPasswordSet"] : T["Account_ReaderPasswordNone"])
                        }
                    </dd>
                </div>
            </dl>
            @if (_readerPassword is not null)
            {
                <p class="status status-warn">@T["Account_ReaderPasswordOnce"]</p>
            }
            <div class="row-actions">
                <form method="post" @formname="reader" @onsubmit="CreateReaderPasswordAsync">
                    <AntiforgeryToken />
                    <button type="submit" class="button button-secondary">@(_hasReaderPassword ? T["Account_ReaderRenew"] : T["Account_ReaderCreate"])</button>
                </form>
                @if (_hasReaderPassword)
                {
                    <form method="post" @formname="reader-revoke" @onsubmit="RevokeReaderPasswordAsync">
                        <AntiforgeryToken />
                        <button type="submit" class="link-button link-danger">@T["Account_ReaderRevoke"]</button>
                    </form>
                }
            </div>
        </section>
    </div>
</div>

@* AGPL section 13: users of a network service get a way to the source. A fork that runs modified code points this to its own repository. *@
<p class="hint">@T["Account_License"] <a href="@SourceCodeUrl" rel="noopener">@T["Account_SourceCode"]</a></p>

@code {
    private const string SourceCodeUrl = "https://github.com/maxcarl/morning-ink";

    private string? _notice;
    private List<string> _errors = [];
    private string? _readerPassword;
    private bool _hasReaderPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!; // ! is safe: always set during static rendering

    [SupplyParameterFromForm]
    private PasswordInput Input { get; set; } = default!; // ! is safe: set in OnInitialized before rendering

    private Guid UserId => HttpContext.User.Id();

    // What readers enter as catalog address; behind a proxy, the address the browser used.
    private string CatalogUrl => $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/opds";

    protected override async Task OnInitializedAsync()
    {
        // Set here, not as initializer: form binding assigns the property on POST.
        Input ??= new();
        _hasReaderPassword = await Readers.HasPasswordAsync(UserId, HttpContext.RequestAborted);
    }

    // Shown once on this answer only; a new one ends the old, e.g. after a reader got lost.
    private async Task CreateReaderPasswordAsync()
    {
        _readerPassword = await Readers.CreateAsync(UserId, HttpContext.RequestAborted);
        _hasReaderPassword = true;
    }

    private async Task RevokeReaderPasswordAsync()
    {
        await Readers.RevokeAsync(UserId, HttpContext.RequestAborted);
        _hasReaderPassword = false;
        _notice = T["Account_ReaderRevoked"];
    }

    private async Task ChangeAsync()
    {
        var userId = UserId;
        var errors = await Users.ChangeOwnPasswordAsync(userId, Input.Current, Input.New, HttpContext.RequestAborted);
        Input.Current = string.Empty;
        Input.New = string.Empty;
        if (errors.Count > 0)
        {
            _errors = errors.Select(ErrorText).Distinct().ToList();
            return;
        }

        // The change renewed the security stamp; a fresh cookie keeps this session, while all others end.
        if (await SignInManager.UserManager.FindByIdAsync(userId.ToString()) is { } login)
        {
            await SignInManager.RefreshSignInAsync(login);
        }

        _notice = T["Account_Changed"];
    }

    private string ErrorText(string code) => code switch
    {
        // Identity's code for a wrong current password.
        "PasswordMismatch" => T["Account_WrongCurrent"],
        _ => T[$"Error_{code}"] is { ResourceNotFound: false } text ? text.Value : T["Error_Unknown"],
    };

    private sealed class PasswordInput
    {
        public string Current { get; set; } = string.Empty;

        public string New { get; set; } = string.Empty;
    }
}
