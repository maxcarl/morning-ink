@page "/"
@rendermode InteractiveServer
@inherits InteractivePage
@using System.Globalization
@using MorningInk.Application.Scheduling
@using MorningInk.Domain
@using MorningInk.Infrastructure.Profiles
@inject TimeProvider Time

<PageTitle>@T["Home_Title"] – @T["Brand"]</PageTitle>

@* No page title block: the tab says where we are, and the next issue is what the page is about. *@
<h1 class="visually-hidden">@T["Home_Title"]</h1>
@if (_notice is not null)
{
    @* Stays while the page follows the issue; it goes when the issue is done. *@
    <div class="alert alert-ok toast toast-sticky" role="status"><p>@_notice</p></div>
}

@if (_view is { } view)
{
    var lead = view.Editions[0];
    var several = view.Editions.Count > 1;
    var notes = Notes(view).ToList();

    @* What is missing comes first, but only when something is: a page that works stays quiet. *@
    @if (notes.Count > 0)
    {
        <section class="alert alert-warn" aria-labelledby="notes-heading">
            <h2 id="notes-heading" class="alert-title">@T["Dash_Notes"]</h2>
            <ul class="notes">
                @foreach (var (text, href) in notes)
                {
                    <li>@if (href is null) { @text } else { <a href="@href">@text</a> }</li>
                }
            </ul>
        </section>
    }

    @* The lead story: the next issue, with its two actions right beside it. *@
    <section class="next-issue" aria-labelledby="next-heading">
        <div class="next-issue-main">
            <span class="kicker">@T["Dash_Next"]</span>
            <h2 id="next-heading" class="lead-headline">@Headline(lead.NextIssue, lead.Profile)</h2>
            <p class="next-issue-facts">@NextFacts(lead)</p>
        </div>
        <div class="next-issue-actions">
            <a class="button button-secondary" href="/preview?edition=@lead.Profile.Id">@T["Preview_Open"]</a>
            @SendButton(lead, view, small: false)
        </div>
        @if (!lead.CanSend || !view.MailServerSet)
        {
            @* Right at the button: on a phone the notes that explain it may be out of view. *@
            <p id="send-blocked-@lead.Profile.Id" class="hint next-issue-hint">@T["Dash_SendBlocked"]</p>
        }
    </section>

    @if (several)
    {
        <h2 class="department">@T["Dash_Editions"]</h2>
        <ul class="rows">
            @foreach (var edition in view.Editions.Skip(1))
            {
                <li class="row" @key="edition.Profile.Id">
                    <div class="row-main">
                        <div class="row-title">@edition.Profile.Title</div>
                        <div class="row-meta">@Headline(edition.NextIssue, edition.Profile) · @T["Dash_IssueTitle", edition.NextNumber]</div>
                    </div>
                    @SendButton(edition, view, small: true)
                </li>
            }
        </ul>
    }

    <h2 class="department">@T["Dash_Recent"]</h2>
    @if (view.Issues.Count == 0)
    {
        <p class="muted">@T["Dash_NoIssues"]</p>
    }
    <ul class="issues" aria-live="polite">
        @foreach (var issue in view.Issues)
        {
            var profile = ProfileOf(issue);
            var logOpen = _logId == issue.Id;
            <li class="issue" @key="issue.Id">
                @* Fixed columns: number and date, facts, status, log; the status has a word, colour only adds to it. *@
                <div class="issue-line">
                    <span class="issue-name">@(several ? $"{profile?.Title} · " : null)@T["Dash_IssueTitle", issue.Number]</span>
                    <span class="issue-date">@Clock.DateAndTime(T, Local(issue.ScheduledFor, profile))</span>
                    <span class="issue-facts">@Facts(issue, profile)</span>
                    <span class="badge @StatusClass(issue.Status)">@T[$"Status_{issue.Status}"]</span>
                    @if (issue.Log.Count > 0)
                    {
                        <button type="button" class="link-button issue-log-toggle" aria-expanded="@(logOpen ? "true" : "false")" aria-controls="log-@issue.Id" @onclick="() => _logId = logOpen ? null : issue.Id">
                            @(logOpen ? T["Log_Hide"] : T["Log_Show"])<span class="visually-hidden"> – @T["Dash_IssueTitle", issue.Number]</span>
                        </button>
                    }
                </div>
                @if (issue.Error is not null && issue.Status == IssueStatus.Failed)
                {
                    <p class="issue-note issue-note-error">@DeliveryTexts.Describe(T, issue.ErrorReason, issue.ErrorArguments, issue.Error)</p>
                }
                @if (issue.Problems.Count > 0)
                {
                    <p class="issue-note">@T["Dash_Unavailable"] @string.Join(" · ", issue.Problems)</p>
                }
                @if (logOpen)
                {
                    <div id="log-@issue.Id"><IssueLogView Entries="issue.Log" Zone="ProfileTimeZone.Find(profile?.TimeZoneId ?? TimeZoneInfo.Utc.Id)" /></div>
                }
            </li>
        }
    </ul>
    @if (view.Issues.Count > 0)
    {
        <p class="more"><a href="/archive">@T["Dash_ToArchive"]</a></p>
    }
}

@code {
    // How often and how long the page looks for the issue that "send now" started.
    private static readonly TimeSpan PollEvery = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan PollFor = TimeSpan.FromMinutes(5);

    // The wizard started the issue a moment before this page opened.
    private static readonly TimeSpan FollowBack = TimeSpan.FromMinutes(1);

    private NewsroomView? _view;
    private Guid? _logId;
    private string? _notice;
    private bool _sending;

    protected override Task LoadAsync() => ReloadAsync();

    private async Task ReloadAsync() => _view = await UseAsync<Newsroom, NewsroomView>(newsroom => newsroom.LoadAsync(UserId, Closed));

    /// <summary>Set by the setup wizard after it started the first issue, so the page follows it.</summary>
    [SupplyParameterFromQuery(Name = "sent")]
    private bool Sent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only once the page is interactive: while prerendering, nothing could update it later.
        if (firstRender && Sent && RendererInfo.IsInteractive)
        {
            await FollowAsync(Time.GetUtcNow() - FollowBack);
        }
    }

    // One per edition: the lead gets a big one, the others a small one in their row.
    private RenderFragment SendButton(Edition edition, NewsroomView view, bool small) => __builder =>
    {
        var blocked = !edition.CanSend || !view.MailServerSet;
        <button type="button" class="button @(small ? "button-secondary button-small" : null)" disabled="@(blocked || _sending)"
                aria-describedby="@(blocked && !small ? $"send-blocked-{edition.Profile.Id}" : null)" @onclick="() => SendNowAsync(edition.Profile.Id)">
            @T["Dash_SendNow"]<span class="visually-hidden"> – @edition.Profile.Title</span>
        </button>
    };

    // What is missing before issues can go out, each with where to fix it; with several editions, each says which.
    private IEnumerable<(string Text, string? Href)> Notes(NewsroomView view)
    {
        var several = view.Editions.Count > 1;
        foreach (var edition in view.Editions.Where(e => !e.CanSend))
        {
            var prefix = several ? $"{edition.Profile.Title}: " : string.Empty;
            var href = $"/profile/{edition.Profile.Id}";
            if (string.IsNullOrEmpty(edition.Profile.Recipient))
            {
                yield return (prefix + T["Dash_NeedRecipient"], href);
            }

            if (edition.Profile.Sections.Count == 0)
            {
                yield return (prefix + T["Dash_NeedSections"], href);
            }
        }

        if (!view.Editions[0].CanSend && !several)
        {
            yield return (T["Dash_Wizard"], "/welcome");
        }

        if (!view.MailServerSet)
        {
            yield return IsAdmin ? (T["Dash_NeedMailAdmin"], "/settings") : (T["Dash_NeedMail"], null);
        }
    }

    // "„Morning Ink“ · No. 14 · 3 sections · to name_abc@kindle.com": facts in a line, not a sentence to read.
    private string NextFacts(Edition edition)
    {
        var profile = edition.Profile;
        var facts = new List<string> { $"{T["Quote_Open"]}{profile.Title}{T["Quote_Close"]}", T["Dash_IssueTitle", edition.NextNumber], profile.Sections.Count == 1 ? T["Dash_SectionCount_One"] : T["Dash_SectionCount", profile.Sections.Count] };
        if (!string.IsNullOrEmpty(profile.Recipient))
        {
            facts.Add(T["Dash_To", profile.Recipient]);
        }

        return string.Join(" · ", facts);
    }

    private async Task SendNowAsync(Guid profileId)
    {
        var since = Time.GetUtcNow();
        if (await UseAsync<Newsroom, bool>(newsroom => newsroom.SendNowAsync(UserId, profileId, Closed)))
        {
            await FollowAsync(since);
        }
    }

    // The issue is built in the background; look for it until it is done, so the page shows how it went.
    private async Task FollowAsync(DateTimeOffset since)
    {
        _sending = true;
        _notice = T["Dash_SendStarted"];
        StateHasChanged();

        using var timer = new PeriodicTimer(PollEvery);
        var until = Time.GetUtcNow() + PollFor;
        try
        {
            while (Time.GetUtcNow() < until && await timer.WaitForNextTickAsync(Closed))
            {
                await ReloadAsync();
                StateHasChanged();
                if (_view?.Issues.FirstOrDefault() is { } latest && latest.CreatedAt >= since && latest.Status is not IssueStatus.Building)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The tab closed; the issue is still built and sent.
            return;
        }

        _notice = null;
        _sending = false;
        StateHasChanged();
    }

    // Weekday and short time; "t" inside a custom format would mean the AM/PM letter, so the two are formatted apart.
    private string Headline(DateTimeOffset utc, Profile profile)
    {
        var local = Local(utc, profile);
        return $"{local.ToString("dddd", CultureInfo.CurrentCulture)}, {Clock.Time(T, local)}";
    }

    private Profile? ProfileOf(Issue issue) => _view?.Editions.FirstOrDefault(e => e.Profile.Id == issue.ProfileId)?.Profile;

    // Times show in the edition's own time zone.
    private static DateTimeOffset Local(DateTimeOffset utc, Profile? profile) => TimeZoneInfo.ConvertTime(utc, ProfileTimeZone.Find(profile?.TimeZoneId ?? "UTC"));

    private string Facts(Issue issue, Profile? profile)
    {
        var facts = new List<string>();
        // Merged duplicates are entries too, only so they count as seen; they are not in the issue.
        if (issue.Entries.Count(e => !e.Duplicate) is var articles and > 0)
        {
            facts.Add(T["Dash_Articles", articles]);
        }

        if (issue.FileSize is { } size)
        {
            facts.Add(string.Create(CultureInfo.CurrentCulture, $"{size / 1024.0 / 1024.0:0.0} MB"));
        }

        if (issue.DeliveredAt is { } delivered)
        {
            facts.Add(T["Dash_DeliveredAt", Clock.Time(T, Local(delivered, profile))]);
        }

        if (issue.Attempts.Any(a => !a.Succeeded))
        {
            facts.Add(T["Dash_Attempts", issue.Attempts.Count]);
        }

        return string.Join(" · ", facts);
    }

    private static string StatusClass(IssueStatus status) => status switch
    {
        IssueStatus.Delivered => "status-ok",
        IssueStatus.Failed => "status-error",
        IssueStatus.Empty => "muted",
        _ => "status-warn",
    };
}
