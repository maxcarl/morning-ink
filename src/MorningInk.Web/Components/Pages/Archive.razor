@page "/archive"
@rendermode InteractiveServer
@inherits InteractivePage
@using MorningInk.Application.Delivery
@using MorningInk.Application.Scheduling
@using MorningInk.Domain
@using MorningInk.Infrastructure.Profiles

<PageTitle>@T["Archive_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <div class="page-title-row">
        <h1>@T["Archive_Title"]</h1>
        <a class="button button-secondary button-small" href="/stats">@T["Stats_Title"]</a>
    </div>
    <p class="lede">@T["Archive_Lede"]</p>
    <Messages Notice="@_notice" Error="@_error" />
</header>

<div class="search">
    <label class="visually-hidden" for="archive-search">@T["Archive_Search"]</label>
    <input id="archive-search" class="input" type="search" placeholder="@T["Archive_Search"]" @bind="_search" @bind:event="oninput" @bind:after="ReloadAsync" />
</div>

@if (_page is { } page)
{
    var several = page.Issues.Select(i => i.Profile.Id).Distinct().Count() > 1;
    @if (page.Issues.Count == 0)
    {
        <p class="muted">@(string.IsNullOrWhiteSpace(_search) ? T["Archive_Empty"] : T["Archive_NoneFound"])</p>
    }
    @* A shelf of front pages, newest first; a cover opens its issue's line with the actions just below it. *@
    <ul class="cover-grid" aria-live="polite">
        @foreach (var item in page.Issues)
        {
            var issue = item.Issue;
            var name = $"{T["Dash_IssueTitle", issue.Number]} · {Clock.DateAndTime(T, IssueTexts.Local(issue.ScheduledFor, item.Profile))}";
            var selected = _selectedId == issue.Id;
            var open = _openId == issue.Id;
            var inIssue = issue.Entries.Where(e => !e.Duplicate).ToList();
            var logOpen = _logId == issue.Id;
            var leftOutOpen = _leftOutId == issue.Id;
            <li class="cover-card" @key="issue.Id">
                <button type="button" class="cover-button" aria-expanded="@(selected ? "true" : "false")" aria-controls="issue-@issue.Id" @onclick="() => _selectedId = selected ? null : issue.Id">
                    @* Decorative: the words below name the issue. The small cover is made from the file, so none without one. *@
                    @if (item.FileAvailable)
                    {
                        <img class="issue-cover" src="/archive/@issue.Id/cover" alt="" loading="lazy" width="250" height="400" />
                    }
                    else
                    {
                        <span class="issue-cover" aria-hidden="true"></span>
                    }
                    <span class="cover-name">@(several ? $"{item.Profile.Title} · " : null)@T["Dash_IssueTitle", issue.Number]</span>
                    <span class="cover-date">@IssueTexts.Local(issue.ScheduledFor, item.Profile).ToString("d", System.Globalization.CultureInfo.CurrentCulture)</span>
                    <span class="badge @IssueTexts.StatusClass(issue.Status)">@IssueTexts.Status(T, issue, item.Profile)</span>
                </button>
            </li>
            @if (selected)
            {
                @* The same columns as on the overview, with the actions at the end of the line. *@
                <li id="issue-@issue.Id" class="issue cover-details" @key="(issue.Id, true)">
                    <div class="issue-line archive-line">
                        <span class="issue-name">@(several ? $"{item.Profile.Title} · " : null)@T["Dash_IssueTitle", issue.Number]</span>
                        <span class="issue-date">@Clock.DateAndTime(T, IssueTexts.Local(issue.ScheduledFor, item.Profile))</span>
                        <span class="issue-facts">@string.Join(" · ", IssueTexts.Facts(T, issue))</span>
                        <span class="badge @IssueTexts.StatusClass(issue.Status)">@IssueTexts.Status(T, issue, item.Profile)</span>
                        <span class="issue-actions">
                            @if (item.FileAvailable)
                            {
                                @* A plain link: the browser downloads it with the user's sign-in cookie. *@
                                <a class="link-button" href="/archive/@issue.Id/file" download>@T["Archive_Download"]<span class="visually-hidden"> – @name</span></a>
                                @if (item.Profile.SendByEmail)
                                {
                                    <button type="button" class="link-button" disabled="@(_sendingId is not null)" @onclick="() => SendAgainAsync(issue.Id)">@T["Archive_SendAgain"]<span class="visually-hidden"> – @name</span></button>
                                }
                            }
                            else if (issue.Status == IssueStatus.Building)
                            {
                                @* Also for an issue left building by a restart: nothing would ever finish it. *@
                                <button type="button" class="link-button link-danger" @onclick="() => CancelAsync(issue.ProfileId)">@T["Dash_Cancel"]<span class="visually-hidden"> – @name</span></button>
                            }
                            else
                            {
                                <span class="muted">@T["Archive_FileGone"]</span>
                            }
                            @* Kept issues survive the cleanup; the pressed state says so, not only the look. *@
                            <button type="button" class="link-button @(issue.Pinned ? "pinned" : null)" aria-pressed="@(issue.Pinned ? "true" : "false")" @onclick="() => TogglePinAsync(issue)">@T["Archive_Keep"]<span class="visually-hidden"> – @name</span></button>
                        </span>
                    </div>
                    @if (inIssue.Count > 0 || issue.Log.Count > 0 || issue.LeftOut.Count > 0)
                    {
                        <div class="issue-more">
                            @if (inIssue.Count > 0)
                            {
                                <button type="button" class="link-button" aria-expanded="@(open ? "true" : "false")" aria-controls="entries-@issue.Id" @onclick="() => _openId = open ? null : issue.Id">
                                    @(open ? T["Archive_HideArticles"] : T["Archive_ShowArticles", inIssue.Count])
                                </button>
                            }
                            @if (issue.LeftOut.Count > 0)
                            {
                                <button type="button" class="link-button" aria-expanded="@(leftOutOpen ? "true" : "false")" aria-controls="left-out-@issue.Id" @onclick="() => _leftOutId = leftOutOpen ? null : issue.Id">
                                    @(leftOutOpen ? T["Archive_HideLeftOut"] : T["Archive_ShowLeftOut", issue.LeftOut.Count])
                                </button>
                            }
                            @if (issue.Log.Count > 0)
                            {
                                <button type="button" class="link-button" aria-expanded="@(logOpen ? "true" : "false")" aria-controls="log-@issue.Id" @onclick="() => _logId = logOpen ? null : issue.Id">
                                    @(logOpen ? T["Log_Hide"] : T["Log_Show"])
                                </button>
                            }
                        </div>
                    }
                    @if (logOpen)
                    {
                        <div id="log-@issue.Id"><IssueLogView Entries="issue.Log" Zone="ProfileTimeZone.Find(item.Profile.TimeZoneId)" /></div>
                    }
                    @if (leftOutOpen)
                    {
                        @* What the filters kept out, by section, each with the way to its filter: a wrong rule is fixed where it lives,
                           and the article comes with the next issue, since it never counted as seen. *@
                        <div id="left-out-@issue.Id">
                            <p class="hint">@T["Archive_LeftOutHint"]</p>
                            @foreach (var group in issue.LeftOut.GroupBy(a => a.Section))
                            {
                                <h3 class="label">@group.Key</h3>
                                <ul class="headline-list headline-list-dropped">
                                    @foreach (var article in group)
                                    {
                                        <li>
                                            <a href="@article.Url" rel="noopener noreferrer" target="_blank">@article.Title</a>
                                            <div class="row-meta">
                                                @article.SourceName · @LeftOutReason(article) ·
                                                <a href="@FilterLink(article, issue.ProfileId)">@T["Archive_EditFilter"]<span class="visually-hidden"> – @article.Title</span></a>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    @if (open)
                    {
                        <ul id="entries-@issue.Id" class="headline-list">
                            @foreach (var entry in inIssue.OrderBy(e => e.SourceName, StringComparer.CurrentCulture))
                            {
                                <li>
                                    <a href="@entry.Url" rel="noopener noreferrer" target="_blank">@entry.Title</a>
                                    <div class="row-meta">@entry.SourceName</div>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        }
    </ul>
    @if (page.HasMore)
    {
        <button type="button" class="button button-secondary" @onclick="MoreAsync">@T["Archive_More"]</button>
    }
}

@code {
    private const int PageSize = 20;

    private ArchivePage? _page;
    private string _search = string.Empty;
    private int _take = PageSize;
    private Guid? _selectedId;
    private Guid? _openId;
    private Guid? _logId;
    private Guid? _leftOutId;
    private Guid? _sendingId;
    private string? _notice;
    private string? _error;

    protected override Task LoadAsync() => ReloadAsync();

    private async Task ReloadAsync() =>
        _page = await UseAsync<IssueArchive, ArchivePage>(archive => archive.ListAsync(UserId, _search, _take, Closed));

    private Task MoreAsync()
    {
        _take += PageSize;
        return ReloadAsync();
    }

    private async Task SendAgainAsync(Guid issueId)
    {
        _notice = _error = null;
        _sendingId = issueId;
        try
        {
            var recipient = _page?.Issues.FirstOrDefault(i => i.Issue.Id == issueId)?.Profile.Recipient;
            switch (await UseAsync<IssueArchive, DeliveryResult?>(archive => archive.ResendAsync(UserId, issueId, Closed)))
            {
                case DeliveryResult.Delivered:
                    _notice = T["Archive_Sent", recipient ?? string.Empty];
                    break;
                case DeliveryResult.Failure failure:
                    _error = T["Archive_SendFailed", DeliveryTexts.Describe(T, failure)];
                    break;
                default:
                    _error = T["Archive_FileGone"];
                    break;
            }

            await ReloadAsync();
        }
        finally
        {
            _sendingId = null;
        }
    }

    private async Task CancelAsync(Guid profileId)
    {
        _error = null;
        _notice = await UseAsync<Newsroom, bool>(newsroom => newsroom.CancelAsync(UserId, profileId, Closed)) ? T["Dash_CancelRequested"] : T["Dash_NothingToCancel"];
        await ReloadAsync();
    }

    // The reasons in the words of the source preview; an unknown one (from a newer version) says nothing rather than a code.
    private string LeftOutReason(LeftOutArticle article)
    {
        var text = T[$"Sources_Reason_{article.Reason}", article.Detail ?? string.Empty];
        return text.ResourceNotFound ? string.Empty : text.Value;
    }

    // An interest is the edition's, everything else the source's rules.
    private static string FilterLink(LeftOutArticle article, Guid profileId) =>
        article.Reason == "Interest" || article.SourceId is not { } sourceId
            ? $"/profile/{profileId}#interests-heading"
            : $"/sources?edit={sourceId}#source-{sourceId}";

    private async Task TogglePinAsync(Issue issue)
    {
        await UseAsync<IssueArchive, bool>(archive => archive.SetPinnedAsync(UserId, issue.Id, !issue.Pinned, Closed));
        await ReloadAsync();
    }

}
