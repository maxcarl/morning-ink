@page "/sources"
@rendermode InteractiveServer
@inherits InteractivePage
@using MorningInk.Application.Processing
@using MorningInk.Application.Sources
@using MorningInk.Domain
@using MorningInk.Infrastructure.Http
@using MorningInk.Infrastructure.Profiles
@using MorningInk.Infrastructure.Sources
@inject HostAllowlist Allowlist

<PageTitle>@T["Sources_Title"] – @T["Brand"]</PageTitle>

<header class="page-header">
    <h1>@T["Sources_Title"]</h1>
    <p class="lede">@T["Sources_Count", _sources.Count(s => s.Kind != SourceKind.Local), _sources.Count(s => s.Kind == SourceKind.Local)]</p>

    @if (_notice is not null)
    {
        <div class="alert alert-ok toast" role="status"><p>@_notice</p></div>
    }
    @if (_error is not null)
    {
        <div class="alert alert-error toast" role="alert"><p>@_error</p></div>
    }
    @if (_blockedHost is not null)
    {
        <div class="alert alert-error" role="alert">
            <p>@T["Sources_Blocked", _blockedHost]</p>
            @if (IsAdmin)
            {
                <p>@T["Sources_AllowHint"]</p>
                <button type="button" class="button" disabled="@_busy" @onclick="AllowAsync">@T["Sources_AllowHost", _blockedHost]</button>
            }
            else
            {
                <p>@T["Sources_AskAdmin"]</p>
            }
        </div>
    }
</header>

<div class="with-sidebar">
    <div>
        @* While adding, the search and its results stand on top, where the user is looking. *@
        @if (Adding)
        {
            @AddSection
        }

        @foreach (var group in _sources.GroupBy(s => s.Kind).OrderBy(g => g.Key))
        {
            <h2 class="department">@T[$"Sources_Group_{group.Key}"]</h2>
            <ul class="rows">
                @foreach (var source in group)
                {
                    <li class="row @(source.Id == _selectedId ? "row-selected" : null)" @key="source.Id">
                        <div class="row-main">
                            <div class="row-title">@source.Name</div>
                            <div class="row-meta">@Describe(source)</div>
                        </div>
                        @if (source.FetchFullText)
                        {
                            <span class="badge">@T["Sources_FullTextFact"]</span>
                        }
                        <div class="row-actions">
                            @if (source.Id == _confirmId)
                            {
                                @* Deleting also drops the source from every section: ask once. *@
                                <p class="confirm" role="alert">@T["Confirm_Delete", source.Name]</p>
                                <button type="button" class="button button-small" disabled="@_busy" @onclick="() => DeleteAsync(source.Id)">@T["Confirm_Yes"]</button>
                                <button type="button" class="link-button" @onclick="() => _confirmId = null">@T["Confirm_Cancel"]</button>
                            }
                            else
                            {
                                @* The hidden name tells screen readers which of the many "Test" buttons this is. *@
                                <button type="button" class="link-button" disabled="@_busy" @onclick="() => TestAsync(source)">@T["Sources_Test"]<span class="visually-hidden"> – @source.Name</span></button>
                                <button type="button" class="link-button" aria-expanded="@(source.Id == _editId ? "true" : "false")" aria-controls="edit-@source.Id" @onclick="() => ToggleEdit(source)">@(source.Id == _editId ? T["Profile_Close"] : T["Profile_Edit"])<span class="visually-hidden"> – @source.Name</span></button>
                                <button type="button" class="link-button link-danger" @onclick="() => _confirmId = source.Id">@T["Sources_Delete"]<span class="visually-hidden"> – @source.Name</span></button>
                            }
                        </div>
                        @if (source.Id == _editId)
                        {
                            @* Name, limits and filters; the filters run before the full text is fetched (see ArticleFilter). *@
                            <form id="edit-@source.Id" class="source-editor" @onsubmit="() => SaveSourceAsync(source.Id)">
                                <div class="inline-form field">
                                    <div class="row-main">
                                        <label class="label" for="source-name">@T["Sources_Name"]</label>
                                        <input id="source-name" class="input" @bind="_edit.Name" required />
                                    </div>
                                    <div>
                                        <label class="label" for="source-max">@T["Sources_MaxArticles"]</label>
                                        <input id="source-max" class="input" type="number" min="1" max="100" @bind="_edit.MaxArticles" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label for="source-include">@T["Sources_Include"]</label>
                                    <input id="source-include" class="input" @bind="_edit.Include" placeholder="@T["Sources_IncludePlaceholder"]" aria-describedby="source-include-hint" />
                                    <span id="source-include-hint" class="hint">@T["Sources_IncludeHint"]</span>
                                </div>
                                <div class="field">
                                    <label for="source-exclude">@T["Sources_Exclude"]</label>
                                    <input id="source-exclude" class="input" @bind="_edit.Exclude" placeholder="@T["Sources_ExcludePlaceholder"]" aria-describedby="source-exclude-hint" />
                                    <span id="source-exclude-hint" class="hint">@T["Sources_ExcludeHint"]</span>
                                </div>
                                <div class="inline-form field">
                                    <div>
                                        <label class="label" for="source-minwords">@T["Sources_MinWords"]</label>
                                        <input id="source-minwords" class="input" type="number" min="1" @bind="_edit.MinWords" placeholder="@T["Sources_NoMinimum"]" />
                                    </div>
                                    <div class="row-main checks">
                                        <label class="checkbox"><input id="source-live" type="checkbox" @bind="_edit.SkipLiveTickers" /> @T["Sources_SkipLive"]</label>
                                        <label class="checkbox"><input id="source-ads" type="checkbox" @bind="_edit.SkipAds" aria-describedby="source-ads-hint" /> @T["Sources_SkipAds"]</label>
                                        <span id="source-ads-hint" class="hint">@T["Sources_SkipAdsHint"]</span>
                                        <label class="checkbox"><input type="checkbox" @bind="_edit.FetchFullText" /> @T["Sources_FullText"]</label>
                                    </div>
                                </div>
                                <div class="field">
                                    <label class="checkbox"><input id="source-local-ai" type="checkbox" @bind="_edit.LocalAiOnly" aria-describedby="source-local-ai-hint" /> @T["Sources_LocalAiOnly"]</label>
                                    <span id="source-local-ai-hint" class="hint">@T["Sources_LocalAiOnlyHint"]</span>
                                </div>
                                @if (source.Kind == SourceKind.FreshRss)
                                {
                                    <div class="field">
                                        <label class="checkbox"><input id="source-mark-read" type="checkbox" @bind="_edit.MarkReadAfterDelivery" /> @T["Sources_MarkRead"]</label>
                                    </div>
                                }
                                <div class="row-actions">
                                    <button type="submit" class="button button-small" disabled="@_busy">@T["Profile_Save"]<span class="visually-hidden"> – @source.Name</span></button>
                                    <button type="button" class="link-button" @onclick="() => _editId = null">@T["Confirm_Cancel"]</button>
                                </div>
                            </form>
                        }
                    </li>
                }
            </ul>
        }

        @if (_sources.Count == 0 && _found is null)
        {
            <p class="muted">@T["Sources_Empty"]</p>
        }

        @if (!Adding)
        {
            @AddSection
        }
    </div>

    <aside class="sidebar" aria-labelledby="preview-label" aria-live="polite">
        <h2 id="preview-label" class="department">@T["Sources_Preview"]</h2>
        @if (_preview is null)
        {
            <p class="muted">@(_busy ? T["Sources_Loading"] : T["Sources_PreviewHint"])</p>
        }
        else
        {
            <h2>@_preview.Name</h2>
            <p class="row-meta">@(_preview.Url ?? _preview.Place)</p>
            <dl class="facts">
                <div><dt>@T["Sources_Type"]</dt><dd>@KindName(_preview.Kind)</dd></div>
                <div><dt>@T["Sources_Limits"]</dt><dd>@T["Sources_LimitsValue", _preview.MaxArticles, (int)_preview.MaxAge.TotalHours]</dd></div>
                <div><dt>@T["Sources_FullTextFact"]</dt><dd>@(_preview.FetchFullText ? T["Sources_On"] : T["Sources_Off"])</dd></div>
                <div>
                    <dt>@T["Sources_Status"]</dt>
                    <dd class="status @(_previewResult is SourceResult.Failure ? "status-error" : "status-ok")">@(_previewResult is SourceResult.Failure ? T["Sources_Failed"] : T["Sources_Works"])</dd>
                </div>
            </dl>
            @switch (_previewResult)
            {
                case SourceResult.Success { Articles.Count: > 0 } success:
                    @* The same rules as the issue, so changed filters show their effect right here. *@
                    var judged = success.Articles.Select(article => (Article: article, Verdict: Verdict(article, _preview))).ToList();
                    var kept = judged.Where(j => j.Verdict is null).ToList();
                    var dropped = judged.Where(j => j.Verdict is not null).ToList();
                    @if (kept.Count > 0)
                    {
                        <span class="label">@T["Sources_LatestArticles"]</span>
                        <ul class="headline-list">
                            @foreach (var (article, _) in kept.Take(PreviewArticles))
                            {
                                <li>
                                    <a href="@article.Url.AbsoluteUri" rel="noopener noreferrer" target="_blank">@article.Title</a>
                                    <div class="row-meta">@string.Join(" · ", new[] { article.Author, article.PublishedAt?.ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture) }.Where(s => !string.IsNullOrEmpty(s)))</div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="status status-warn">@T["Sources_AllFiltered"]</p>
                    }
                    @if (dropped.Count > 0)
                    {
                        <span class="label">@T["Sources_FilteredOut", dropped.Count, judged.Count]</span>
                        <ul class="headline-list headline-list-dropped">
                            @foreach (var (article, verdict) in dropped.Take(DroppedArticles))
                            {
                                <li>
                                    <a href="@article.Url.AbsoluteUri" rel="noopener noreferrer" target="_blank">@article.Title</a>
                                    <div class="row-meta">@Reason(verdict!)</div> @* ! is safe: only dropped articles have a verdict *@
                                </li>
                            }
                        </ul>
                    }
                    @if (_preview.FetchFullText && _preview.MinWords is not null)
                    {
                        <p class="hint">@T["Sources_MinWordsLater"]</p>
                    }
                    break;
                case SourceResult.Failure failure:
                    <p class="status status-error">@SourceTexts.Describe(T, failure.Reason, failure.Arguments, failure.Message)</p>
                    break;
                default:
                    <p class="muted">@T["Sources_NoArticles"]</p>
                    break;
            }
        }
    </aside>
</div>

@code {
    private const int PreviewArticles = 5;

    // Enough to see which rule hits too often, short enough for the sidebar.
    private const int DroppedArticles = 10;

    private List<Source> _sources = [];
    private IReadOnlyList<FeedCandidate>? _found;
    private Source? _preview;
    private SourceResult? _previewResult;
    private Guid? _selectedId;
    private Guid? _confirmId;
    private Guid? _editId;
    private SourceDraft _edit = new();
    private string? _notice;
    private string? _error;
    private string? _blockedHost;
    private bool _busy;

    // FreshRSS: the password stays only until the sources are added, then it is stored encrypted with them.
    private string _freshRssUrl = string.Empty;
    private string _freshRssUser = string.Empty;
    private string _freshRssPassword = string.Empty;
    private FreshRssConnection.Connected? _freshRss;
    private HashSet<string> _freshRssPicked = [];

    // Form fields
    private string _url = string.Empty;
    private string? _feedUrl;
    private string _feedName = string.Empty;
    private bool _fullText = true;
    private string _place = string.Empty;
    private string? _country;

    private bool Adding => _found is not null || _blockedHost is not null || _error is not null;

    private RenderFragment AddSection => __builder =>
    {
        <h2 class="department">@T["Sources_AddHeading"]</h2>
        <form @onsubmit="DiscoverAsync" class="field">
            <label class="label" for="url">@T["Sources_NewLabel"]</label>
            <div class="inline-form">
                <input id="url" class="input" type="text" inputmode="url" @bind="_url" placeholder="https://www.example.com" aria-describedby="url-hint" required />
                <button type="submit" class="button" disabled="@_busy">@(_busy ? T["Sources_Searching"] : T["Sources_Find"])</button>
            </div>
            <span id="url-hint" class="hint">@T["Sources_UrlHint"]</span>
        </form>

        @if (_found is not null)
        {
            <h2 class="department">@T["Sources_Found"]</h2>
            @if (_found.Count == 0)
            {
                <p class="row muted">@T["Sources_NoneFound"]</p>
            }
            else
            {
                @* Pick one of the feeds found, name it, add it. *@
                <form @onsubmit="AddFeedAsync">
                    <fieldset class="rows">
                        <legend class="visually-hidden">@T["Sources_Found"]</legend>
                        @foreach (var feed in _found)
                        {
                            <label class="row checkbox" @key="feed.Url">
                                <input type="radio" name="feed" checked="@(feed.Url.AbsoluteUri == _feedUrl)" @onchange="() => PickAsync(feed)" />
                                <span class="row-main"><span class="row-title">@feed.Title</span><span class="row-meta"> · @feed.Url.AbsoluteUri</span></span>
                            </label>
                        }
                    </fieldset>
                    <div class="inline-form field">
                        <label class="visually-hidden" for="feed-name">@T["Sources_Name"]</label>
                        <input id="feed-name" class="input" @bind="_feedName" required />
                        <label class="checkbox"><input type="checkbox" @bind="_fullText" /> @T["Sources_FullText"]</label>
                        <button type="submit" class="button" disabled="@_busy">@T["Sources_Add"]</button>
                    </div>
                </form>
            }
        }

        <form @onsubmit="AddLocalAsync" class="field">
            <label class="label" for="place">@T["Sources_LocalLabel"]</label>
            <div class="inline-form">
                <input id="place" class="input" type="text" @bind="_place" placeholder="52062" aria-describedby="place-hint" required />
                <label class="visually-hidden" for="local-country">@T["Country"]</label>
                <CountrySelect Id="local-country" @bind-Selected="_country" />
                <button type="submit" class="button button-secondary" disabled="@_busy">@T["Sources_LocalAdd"]</button>
            </div>
            <span id="place-hint" class="hint">@T["Sources_LocalHint"]</span>
        </form>

        @* One's own FreshRSS: sign in once, then pick the categories that become sources. *@
        <form @onsubmit="ConnectFreshRssAsync" class="field" aria-labelledby="freshrss-label">
            <span id="freshrss-label" class="label">@T["Sources_FreshRss"]</span>
            <div class="field-row">
                <div class="field">
                    <label for="freshrss-url">@T["Sources_FreshRssUrl"]</label>
                    <input id="freshrss-url" class="input" type="text" inputmode="url" spellcheck="false" @bind="_freshRssUrl" placeholder="https://freshrss.example.com" required />
                </div>
                <div class="field">
                    <label for="freshrss-user">@T["Login_UserName"]</label>
                    <input id="freshrss-user" class="input" spellcheck="false" autocapitalize="none" autocomplete="off" @attributes="PasswordManagers.Ignore" @bind="_freshRssUser" required />
                </div>
            </div>
            <div class="field">
                <label for="freshrss-password">@T["Sources_FreshRssPassword"]</label>
                <input id="freshrss-password" class="input" type="password" autocomplete="new-password" @attributes="PasswordManagers.Ignore" @bind="_freshRssPassword" aria-describedby="freshrss-hint" required />
                <span id="freshrss-hint" class="hint">@T["Sources_FreshRssHint"]</span>
            </div>
            <button type="submit" class="button button-secondary" disabled="@_busy">@T["Sources_FreshRssConnect"]</button>
        </form>

        @if (_freshRss is { } connected)
        {
            <form @onsubmit="AddFreshRssAsync" class="field">
                <fieldset class="field">
                    <legend class="label">@T["Sources_FreshRssPick"]</legend>
                    <div class="choices">
                        @foreach (var category in connected.Categories)
                        {
                            <label class="checkbox" @key="category.Stream">
                                <input type="checkbox" checked="@_freshRssPicked.Contains(category.Stream)" @onchange="() => PickCategory(category.Stream)" /> @category.Name
                            </label>
                        }
                    </div>
                    <span class="hint">@T["Sources_FreshRssPickHint"]</span>
                </fieldset>
                <button type="submit" class="button" disabled="@_busy">@T["Sources_FreshRssAdd"]</button>
            </form>
        }
    };

    protected override async Task LoadAsync()
    {
        await ReloadAsync();

        // A new local source starts in the profile's country.
        _country = (await UseAsync<ProfileEditor, Profile>(editor => editor.GetOrCreateAsync(UserId, Closed))).Country;
    }

    private async Task ReloadAsync() => _sources = [.. await UseAsync<SourceCatalog, IReadOnlyList<Source>>(catalog => catalog.ListAsync(UserId, Closed))];

    private Task DiscoverAsync() => RunAsync(() => DiscoverAsync(_url));

    private async Task DiscoverAsync(string input)
    {
        _found = null;
        _preview = null;
        switch (await UseAsync<FeedDiscovery, FeedDiscoveryResult>(discovery => discovery.DiscoverAsync(input, Closed)))
        {
            case FeedDiscoveryResult.Found found:
                _found = found.Feeds;
                if (found.Feeds.Count > 0)
                {
                    // Preview the first feed right away, so the user sees what they are about to add.
                    await PickAsync(found.Feeds[0]);
                }

                break;
            case FeedDiscoveryResult.Failure { BlockedHost: { } host }:
                _blockedHost = host;
                break;
            case FeedDiscoveryResult.Failure failure:
                _error = T["Sources_DiscoveryFailed", SourceTexts.Describe(T, failure.Reason, failure.Arguments, failure.Message)];
                break;
        }
    }

    private async Task PickAsync(FeedCandidate feed)
    {
        _feedUrl = feed.Url.AbsoluteUri;
        _feedName = feed.Title;
        _selectedId = null;
        await PreviewAsync(new Source { UserId = UserId, Name = feed.Title, Url = feed.Url.AbsoluteUri });
    }

    private Task AddFeedAsync() => RunAsync(() => SaveAsync(catalog => catalog.AddFeedAsync(UserId, _feedName, _feedUrl ?? string.Empty, _fullText, Closed)));

    private Task AddLocalAsync()
    {
        var place = _place.Trim();
        return RunAsync(() => SaveAsync(catalog => catalog.AddLocalAsync(UserId, $"{T["Sources_Local"]} {place}", place, _country, Closed)));
    }

    private async Task SaveAsync(Func<SourceCatalog, Task<SourceSaveResult>> save)
    {
        if (await UseAsync(save) is SourceSaveResult.Invalid invalid)
        {
            _error = T[$"Error_{invalid.Reason}"];
            return;
        }

        _found = null;
        _preview = null;
        _url = string.Empty;
        _place = string.Empty;
        _notice = T["Sources_Added"];
        await ReloadAsync();
    }

    private Task TestAsync(Source source) => RunAsync(() => TestCoreAsync(source));

    private async Task TestCoreAsync(Source source)
    {
        _selectedId = source.Id;
        _preview = null;
        if (await UseAsync<SourceCatalog, SourceResult?>(catalog => catalog.TestAsync(UserId, source.Id, Closed)) is { } result)
        {
            ShowPreview(source, result);
        }
    }

    private void ToggleEdit(Source source)
    {
        _confirmId = null;
        _editId = _editId == source.Id ? null : source.Id;
        _edit = new SourceDraft
        {
            Name = source.Name,
            MaxArticles = source.MaxArticles,
            Include = string.Join(", ", source.IncludeKeywords),
            Exclude = string.Join(", ", source.ExcludeKeywords),
            MinWords = source.MinWords,
            SkipLiveTickers = source.SkipLiveTickers,
            FetchFullText = source.FetchFullText,
            LocalAiOnly = source.LocalAiOnly,
            MarkReadAfterDelivery = source.MarkReadAfterDelivery,
            SkipAds = source.SkipAds,
        };
    }

    private Task SaveSourceAsync(Guid id) => RunAsync(async () =>
    {
        var settings = new SourceSettings(
            _edit.Name,
            _edit.FetchFullText,
            _edit.MaxArticles,
            SourceSettings.ParseKeywords(_edit.Include),
            SourceSettings.ParseKeywords(_edit.Exclude),
            _edit.MinWords,
            _edit.SkipLiveTickers,
            _edit.LocalAiOnly,
            _edit.SkipAds,
            _edit.MarkReadAfterDelivery);
        if (await UseAsync<SourceCatalog, SourceSaveResult>(catalog => catalog.SaveSettingsAsync(UserId, id, settings, Closed)) is SourceSaveResult.Invalid invalid)
        {
            _error = T[$"Error_{invalid.Reason}"];
            return;
        }

        _notice = T["Profile_Saved"];
        _editId = null;
        await ReloadAsync();
    });

    private Task DeleteAsync(Guid id) => RunAsync(() => DeleteCoreAsync(id));

    private async Task DeleteCoreAsync(Guid id)
    {
        if (await UseAsync<SourceCatalog, bool>(catalog => catalog.DeleteAsync(UserId, id, Closed)))
        {
            _notice = T["Sources_Deleted"];
            if (_preview?.Id == id)
            {
                _preview = null;
            }
        }

        _confirmId = null;
        await ReloadAsync();
    }

    // The host is taken before RunAsync clears the messages, the blocked notice among them.
    private Task AllowAsync()
    {
        var host = _blockedHost;
        return RunAsync(() => AllowCoreAsync(host));
    }

    private async Task AllowCoreAsync(string? host)
    {
        // Checked here, not only by hiding the button: a handler must never trust what the page showed.
        if (!IsAdmin || host is null)
        {
            _error = T["Error_AdminOnly"];
            return;
        }

        await Allowlist.AddAsync(host, UserId, Closed);
        _notice = T["Sources_Allowed", host];
        _blockedHost = null;
        if (!string.IsNullOrWhiteSpace(_url))
        {
            await DiscoverAsync(_url);
        }
    }

    private async Task PreviewAsync(Source draft) => ShowPreview(draft, await UseAsync<SourceCatalog, SourceResult>(catalog => catalog.PreviewAsync(draft, Closed)));

    // The word count needs the full text, which the test does not fetch; with full text on it is checked in the issue only.
    private static FilterVerdict? Verdict(FetchedArticle article, Source source) =>
        ArticleFilter.Reject(article, source)
        ?? (!source.FetchFullText && !ArticleFilter.IsLongEnough(article, source) ? new FilterVerdict(FilterReason.TooShort) : null);

    private string Reason(FilterVerdict verdict) => verdict.Reason switch
    {
        FilterReason.Excluded => T["Sources_Reason_Excluded", verdict.Keyword ?? string.Empty],
        FilterReason.TooShort => T["Sources_Reason_TooShort", _preview?.MinWords ?? 0],
        _ => T[$"Sources_Reason_{verdict.Reason}"],
    };

    private void ShowPreview(Source source, SourceResult result)
    {
        _preview = source;
        _previewResult = result;
        if (result is SourceResult.Failure { BlockedHost: { } host })
        {
            _blockedHost = host;
        }
    }

    private Task ConnectFreshRssAsync() => RunAsync(async () =>
    {
        _freshRss = null;
        _freshRssPicked = [];
        switch (await UseAsync<SourceCatalog, FreshRssConnection>(catalog => catalog.ConnectFreshRssAsync(_freshRssUrl, _freshRssUser, _freshRssPassword, Closed)))
        {
            case FreshRssConnection.Connected connected:
                _freshRss = connected;
                break;
            case FreshRssConnection.Failed { Failure: var failure }:
                _error = T["Sources_FreshRssFailed", SourceTexts.Describe(T, failure.Reason, failure.Arguments, failure.Message)];
                _blockedHost = failure.BlockedHost;
                break;
        }
    });

    private void PickCategory(string stream)
    {
        if (!_freshRssPicked.Remove(stream))
        {
            _freshRssPicked.Add(stream);
        }
    }

    private Task AddFreshRssAsync() => RunAsync(async () =>
    {
        // ! is safe: the form only shows once connected
        var connected = _freshRss!;
        var chosen = connected.Categories.Where(c => _freshRssPicked.Contains(c.Stream)).ToList();
        var added = await UseAsync<SourceCatalog, IReadOnlyList<Source>>(catalog => catalog.AddFreshRssAsync(UserId, connected.Api, _freshRssUser, _freshRssPassword, chosen, Closed));
        _notice = T["Sources_FreshRssAdded", added.Count];
        (_freshRss, _freshRssPicked, _freshRssPassword) = (null, [], string.Empty);
        await ReloadAsync();
    });

    // One action at a time: messages of the last one go, the buttons are disabled while it runs.
    private async Task RunAsync(Func<Task> action)
    {
        _notice = null;
        _error = null;
        _blockedHost = null;
        _busy = true;
        try
        {
            await action();
        }
        finally
        {
            _busy = false;
        }
    }

    // The open editor's fields; only one source is edited at a time.
    private sealed class SourceDraft
    {
        public string Name { get; set; } = string.Empty;

        public int MaxArticles { get; set; }

        public string Include { get; set; } = string.Empty;

        public string Exclude { get; set; } = string.Empty;

        public int? MinWords { get; set; }

        public bool SkipLiveTickers { get; set; }

        public bool FetchFullText { get; set; }

        public bool LocalAiOnly { get; set; }

        public bool MarkReadAfterDelivery { get; set; } = true;

        public bool SkipAds { get; set; } = true;
    }

    private string Describe(Source source)
    {
        var parts = new List<string?> { KindName(source.Kind), source.Kind == SourceKind.Local ? source.Place : source.Url };
        if (source.IncludeKeywords.Count + source.ExcludeKeywords.Count > 0 || source.MinWords is not null || source.SkipLiveTickers)
        {
            parts.Add(T["Sources_Filtered"]);
        }

        return string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
    }

    private string KindName(SourceKind kind) => T[$"Kind_{kind}"];
}
