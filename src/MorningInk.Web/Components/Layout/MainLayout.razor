@inherits LayoutComponentBase
@using System.Globalization
@inject TimeProvider Time

@* Masthead like a newspaper: name, dateline, double rule, tabs. *@
<header class="masthead">
    <div class="masthead-top">
        <a class="brand" href="/">@T["Brand"]</a>
        <div class="dateline">
            <span>@Time.GetLocalNow().ToString("D", CultureInfo.CurrentCulture)</span>
            <span aria-hidden="true">·</span>
            @* POST with antiforgery token: a link or GET could be triggered by another site. *@
            <form method="post" action="/logout">
                <AntiforgeryToken />
                <button type="submit" class="link-button">@T["Logout"]</button>
            </form>
        </div>
    </div>
    <nav class="nav" aria-label="@T["Nav_Label"]">
        <NavLink href="/" Match="NavLinkMatch.All">@T["Nav_Home"]</NavLink>
        <NavLink href="/sources">@T["Nav_Sources"]</NavLink>
        <NavLink href="/profile">@T["Nav_Profile"]</NavLink>
    </nav>
</header>

<main class="page">
    @Body
</main>
