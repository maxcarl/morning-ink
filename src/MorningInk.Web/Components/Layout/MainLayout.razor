@inherits LayoutComponentBase
@using System.Globalization
@inject TimeProvider Time
@inject NavigationManager Navigation

@* Masthead like a newspaper: name, dateline, double rule, tabs. *@
<header class="masthead">
    <div class="masthead-top">
        <a class="brand" href="/">@T["Brand"]</a>
        <div class="dateline">
            <span>@Time.GetLocalNow().ToString("D", CultureInfo.CurrentCulture)</span>
            <span aria-hidden="true">·</span>
            <form method="post" action="/theme" class="theme-switch" aria-label="@T["Theme_Label"]">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@("/" + Navigation.ToBaseRelativePath(Navigation.Uri))" />
                @foreach (var choice in Theme.Choices)
                {
                    <button type="submit" name="theme" value="@choice" class="link-button" aria-pressed="@((choice == _theme).ToString().ToLowerInvariant())">@T[$"Theme_{choice}"]</button>
                }
            </form>
            <span aria-hidden="true">·</span>
            @* POST with antiforgery token: a link or GET could be triggered by another site. *@
            <form method="post" action="/logout">
                <AntiforgeryToken />
                <button type="submit" class="link-button">@T["Logout"]</button>
            </form>
        </div>
    </div>
    <nav class="nav" aria-label="@T["Nav_Label"]">
        <NavLink href="/" Match="NavLinkMatch.All">@T["Nav_Home"]</NavLink>
        <NavLink href="/sources">@T["Nav_Sources"]</NavLink>
        <NavLink href="/profile">@T["Nav_Profile"]</NavLink>
        @if (HttpContext?.User.IsInRole(nameof(MorningInk.Domain.UserRole.Admin)) == true)
        {
            <NavLink href="/settings">@T["Nav_Settings"]</NavLink>
        }
    </nav>
</header>

<main class="page">
    @Body
</main>

@code {
    private string _theme = Theme.Auto;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnInitialized() => _theme = HttpContext is null ? Theme.Auto : Theme.Of(HttpContext);
}
