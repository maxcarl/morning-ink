@using System.Globalization
@using MorningInk.Application.Notifications
@using MorningInk.Domain
@using MorningInk.Infrastructure.Profiles
@inject ActionScopes Scopes

<form @onsubmit="SaveAsync" aria-labelledby="notify-heading">
    <div class="field">
        <label for="notify-channel">@T["Notify_Channel"]</label>
        <select id="notify-channel" class="input" @bind="_channel">
            @foreach (var channel in Enum.GetValues<NotificationChannel>())
            {
                <option value="@channel">@T[$"Notify_Channel_{channel}"]</option>
            }
        </select>
    </div>
    @if (_channel != NotificationChannel.None)
    {
        <div class="field">
            <label for="notify-target">@T[$"Notify_Target_{_channel}"]</label>
            <input id="notify-target" class="input" type="text" spellcheck="false" autocapitalize="none" autocomplete="off" @attributes="PasswordManagers.Ignore" @bind="_target" aria-describedby="notify-target-hint" required />
            <span id="notify-target-hint" class="hint">@T[$"Notify_TargetHint_{_channel}"]</span>
        </div>
        @if (_channel != NotificationChannel.Email)
        {
            <div class="field">
                <label for="notify-secret">@T[$"Notify_Secret_{_channel}"]</label>
                @* Never filled in from storage, like the mail password. *@
                <input id="notify-secret" class="input" type="password" autocomplete="new-password" @attributes="PasswordManagers.Ignore" @bind="_secret" aria-describedby="notify-secret-hint" />
                <span id="notify-secret-hint" class="hint">@(_secretSaved ? T["Notify_SecretSaved"] : T[$"Notify_SecretHint_{_channel}"])</span>
            </div>
        }
    }
    <div class="row-actions">
        <button type="submit" class="button">@T["Profile_Save"]</button>
        @if (Profile?.NotifyChannel is not (null or NotificationChannel.None))
        {
            <button type="button" class="button button-secondary" disabled="@_busy" @onclick="TestAsync">@T["Notify_Test"]</button>
        }
    </div>
</form>

@code {
    private NotificationChannel _channel;
    private string? _target;
    private string? _secret;
    private bool _secretSaved;
    private bool _busy;
    private Profile? _loaded;

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter, EditorRequired]
    public Profile? Profile { get; set; }

    [Parameter]
    public CancellationToken Cancellation { get; set; }

    [Parameter]
    public EventCallback<FormOutcome> Finished { get; set; }

    // Filled from the edition whenever the page hands over another one, e.g. after saving or switching editions.
    protected override void OnParametersSet()
    {
        if (Profile is null || ReferenceEquals(Profile, _loaded))
        {
            return;
        }

        _loaded = Profile;
        _channel = Profile.NotifyChannel;
        _target = Profile.NotifyTarget;
        _secret = null;
        _secretSaved = Profile.NotifySecret is not null;
    }

    private async Task SaveAsync()
    {
        if (Profile is not { } profile)
        {
            return;
        }

        var settings = new NotificationSettings(_channel, _target, _secret);
        var errors = await Scopes.RunAsync<ProfileEditor, IReadOnlyList<string>>(editor => editor.SaveNotificationAsync(UserId, profile.Id, settings, Cancellation));
        await Finished.InvokeAsync(errors.Count == 0
            ? new FormOutcome(T["Profile_Saved"])
            : new FormOutcome(null, [.. errors.Select(field => T[$"Profile_Error_{field}"].Value)]));
    }

    // Tests what is saved, like the AI test, so the token never has to stay in the form.
    private async Task TestAsync()
    {
        if (Profile is not { NotifyTarget: { } target } profile)
        {
            return;
        }

        _busy = true;
        try
        {
            var language = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            var problem = await Scopes.RunAsync<INotifier, string?>(notifier => notifier.NotifyAsync(
                new NotificationTarget(profile.NotifyChannel, target, profile.NotifySecret), new Notice(profile.Title, 0, 0, null, language, IsTest: true), Cancellation));
            var channel = T[$"Notify_Channel_{profile.NotifyChannel}"].Value;
            await Finished.InvokeAsync(problem is null ? new FormOutcome(T["Notify_TestSent", channel]) : FormOutcome.Failed(T["Notify_TestFailed", channel, problem]));
        }
        finally
        {
            _busy = false;
        }
    }
}
