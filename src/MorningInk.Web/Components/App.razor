@using System.Globalization
@* Pages render statically by default; pages that gain from it opt in to interactive server rendering. *@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@Theme.Of(HttpContext)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    @* In cascade order: tokens first, single pages last. *@
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["css/base.css"]" />
    <link rel="stylesheet" href="@Assets["css/layout.css"]" />
    <link rel="stylesheet" href="@Assets["css/components.css"]" />
    <link rel="stylesheet" href="@Assets["css/pages.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    @* Installable as an app (home screen, dock); no service worker, since every page needs the server anyway. *@
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    <link rel="manifest" href="@Assets["manifest.webmanifest"]" />
    <meta name="apple-mobile-web-app-title" content="Morning Ink" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="theme-color" content="#f5f0e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171513" media="(prefers-color-scheme: dark)" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    @* Blazor shows this instead of its own dialog, whose inline styles the Content-Security-Policy would block. *@
    <div id="components-reconnect-modal" class="reconnect" role="alert">
        <p>@T["Reconnect_Lost"] <a href="">@T["Reconnect_Reload"]</a></p>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["drag.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!; // ! is safe: the root component always renders with an HTTP context
}
