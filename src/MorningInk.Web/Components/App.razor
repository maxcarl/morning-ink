@using System.Globalization
@* Pages render statically by default; pages that gain from it opt in to interactive server rendering (ADR 0002). *@
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@Theme.Of(HttpContext)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    @* Blazor shows this instead of its own dialog, whose inline styles the Content-Security-Policy would block. *@
    <div id="components-reconnect-modal" class="reconnect" role="alert">
        <p>@T["Reconnect_Lost"] <a href="">@T["Reconnect_Reload"]</a></p>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["drag.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!; // ! is safe: the root component always renders with an HTTP context
}
